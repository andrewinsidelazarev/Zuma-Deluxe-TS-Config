 514  60FB FE 01            CP 1
 515  60FD 20 25            JR NZ, .ug_state2
 516  60FF 06 0C            LD B, FAST_ADVANCE
 517  6101              .ug_absorb_loop:
 518  6101 C5               PUSH BC
 519  6102 CD D5 72         CALL MoveChainAbsorb
