 108  0000              ; Раскладка SFILE (85 descriptors × 6 байт = 510 байт #0200..#03FD).
 109  0000              ; TSU рендерит descriptors в порядке SFILE, ПОЗДНИЕ поверх ранних (z-order).
 110  0000              ; ACT=0 СТОПИТ рендеринг → следующий descriptor не нарисуется. Поэтому:
 111  0000              ;  • frog/preview всегда активны;
 112  0000              ;  • chain рисуется через DMA в canvas, TSU-слоты DESC_CHAIN0[60] просто
 113  0000              ;    держатся off-screen (Y=#2C + ACT=1) чтобы TSU дошёл до курсора;
 114  0000              ;  • для летящих шаров неактивные слоты тоже ACT=1 + offscreen.
 115  0000              ;   #0200 — лягушка (64×64)
 116  0000              ;   #0206 — mouth-preview (24×24)
 117  0000              ;   #020C — back-preview (8×8)
 118  0000              ;   #0212..#0379 — 60 chain-слотов (360 байт, off-screen для DMA-чейна)
 119  0000              ;   #037A..#03D9 — 16 летящих шаров (96 байт)
 120  0000              ;   #03DA — курсор (16×16)
 121  0000              ;   #03E0..#03FD — пусто
 122  0000              DESC_FROG         EQU #0200    ; 64×64 жаба
 123  0000              DESC_PREVIEW      EQU #0206    ; 24×24 mouth ball — текущий цвет, во рту
 124  0000              DESC_BACK_PREVIEW EQU #020C    ; 8×8 spine preview — следующий цвет, на спине
 125  0000              DESC_KZSKULL      EQU #0212    ; 32×32 череп killzone (TSU sprite, TNUM меняется по KzFrame)
 126  0000              DESC_CHAIN0       EQU #0218    ; 70 chain-слотов (420 байт #0218..#03BB)
 127  0000              DESC_BALL0        EQU #03BC    ; 8 летящих шаров (48 байт #03BC..#03EB)
 128  0000              DESC_CURSOR       EQU #03EC    ; 16×16 курсор #03EC..#03F1
 129  0000
 130  0000              SCR_W    EQU 360
 131  0000              SCR_H    EQU 288
 132  0000              SPR_SIZE EQU 64                                  ; frog 64×64
 133  0000
 134  0000              MIN_X EQU 0
 135  0000              MAX_X EQU 296                                    ; SCR_W - SPR_SIZE
 136  0000              MIN_Y EQU 0
 137  0000              MAX_Y EQU 224                                    ; SCR_H - SPR_SIZE
