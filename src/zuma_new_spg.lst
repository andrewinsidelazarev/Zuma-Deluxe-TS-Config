4044  75A5              ; ================================================================
4045  75A5              ; DRAW SUBTITLE TEXT — "SPIRAL OF DOOM" 5 sprites 64×32 при scattered
4046  75A5              ; TNUMs в page #0D (cx=40..63, cy=0..7). На экране размещены горизонтально
4047  75A5              ; (5 × 64 = 320 px wide, центрированы) при Y = SUBTITLE_Y. SPAL=5.
4048  75A5              ; Использует DESC_CHAIN0[5..9] (TEXT_NUM_SPRITES = 5 первых заняты главным).
4049  75A5              ; ================================================================
4050  75A5              DrawSubtitleText:
4051  75A5 01 AF 15         LD BC, FMADDR
4051  75A8 3E 10          LD A, FM_EN
4051  75AA ED 79          OUT (C), A
4052  75AC 21 36 02         LD HL, DESC_CHAIN0 + TEXT_NUM_SPRITES * 6           ; descriptor offset = 5*6=30
4053  75AF DD 21 EA 75      LD IX, .subtitle_tnums
4054  75B3 06 05            LD B, 5                                              ; 5 sprites
4055  75B5 11 14 00         LD DE, TEXT_X                                        ; current screen X
4056  75B8              .dst_loop:
4057  75B8 36 B8            LD (HL), LOW(SUBTITLE_Y)
4057  75BA 23             INC HL
4058  75BB 36 26            LD (HL), HIGH(SUBTITLE_Y) | SPACT | SPSIZ32
4058  75BD 23             INC HL ; Y_H + ACT + SIZE32 vert (= 32 tall)
4059  75BE
4060  75BE 7B               LD A, E
4061  75BF 77               LD (HL), A
4061  75C0 23             INC HL                                  ; X_L
4062  75C1 7A               LD A, D
4063  75C2 E6 01            AND 1
4064  75C4 F6 0E            OR SPSIZ64
4065  75C6 77               LD (HL), A
