3480  7265 79               LD A, C
3481  7266 3C               INC A
3482  7267 21 9E 85         LD HL, Chain0_SlotsLen
3483  726A BE               CP (HL)
3484  726B 30 0B            JR NC, .snm_settled
3485  726D 26 00            LD H, 0
3485  726F 6F             LD L, A
3486  7270 11 DC 81         LD DE, Chain0_SlotOffsets
3487  7273 19               ADD HL, DE
3488  7274 7E               LD A, (HL)
3489  7275 B7               OR A
3490  7276 20 06            JR NZ, .snm_unsettled
3491  7278              .snm_settled:
3492  7278 E1               POP HL
3493  7279 C1               POP BC
3494  727A 36 00            LD (HL), 0                                ; settled → clear Shot2[C]
3495  727C 18 02            JR .snm_shot2_next
3496  727E              .snm_unsettled:
3497  727E E1               POP HL
3498  727F C1               POP BC
3499  7280                  ; leave Shot2[C] = 1 для retry next frame
3500  7280
3501  7280              .snm_shot2_next:
3502  7280 23               INC HL
3503  7281 0C               INC C
3504  7282 10 9B            DJNZ .snm_shot2_loop
