3699  737D              ; ================================================================
3700  737D              ; UPDATE CHAIN SPRITES — TSU-вариант рендера цепочки (НЕ ИСПОЛЬЗУЕТСЯ).
3701  737D              ; Заменён DMA-конвейером BlitChainToShadow + HideChainSprites. Оставлен
3702  737D              ; в коде как ссылка/легаси, никем не вызывается. Использовал старую формулу
3703  737D              ; t = ChainHeadT - 30*i (rigid body model).
3704  737D              ; ================================================================
3705  737D              UpdateChainSprites:
3706  737D AF               XOR A
3707  737E 32 70 80         LD (TmpChainIdx), A                   ; i = 0
3708  7381              .ucss_loop:
3709  7381 3A 70 80         LD A, (TmpChainIdx)
3710  7384 FE 46            CP TSU_CHAIN_SPRITES                  ; SFILE-резерв (legacy TSU-вариант)
3711  7386 D0               RET NC                                ; i >= TSU_CHAIN_SPRITES → конец
3712  7387
3713  7387                  ; Адрес дескриптора в SFILE: HL = DESC_CHAIN0 + 6*i
3714  7387 26 00            LD H, 0
3714  7389 6F             LD L, A
3715  738A 54               LD D, H
3715  738B 5D             LD E, L
3716  738C 29               ADD HL, HL
3717  738D 19               ADD HL, DE
3718  738E 29               ADD HL, HL                            ; HL = i*6
3719  738F 11 18 02         LD DE, DESC_CHAIN0
3720  7392 19               ADD HL, DE
3721  7393 E5               PUSH HL                               ; сохранить адрес дескриптора
3722  7394
3723  7394                  ; Если i >= SlotsLen → invisible
3724  7394 3A 70 80         LD A, (TmpChainIdx)
3725  7397 21 9E 85         LD HL, Chain0_SlotsLen
3726  739A BE               CP (HL)
3727  739B D2 5A 74         JP NC, .ucss_invisible
3728  739E
3729  739E                  ; GAP-cell → invisible
3730  739E 26 00            LD H, 0
3730  73A0 6F             LD L, A
3731  73A1 11 EC 80         LD DE, Chain0_Slots
3732  73A4 19               ADD HL, DE
3733  73A5 7E               LD A, (HL)
3734  73A6 FE 06            CP NUM_BALL_COLORS
3735  73A8 D2 5A 74         JP NC, .ucss_invisible                ; >= 3 = GAP (любой тип) → не рендерим
3736  73AB
3737  73AB                  ; t = (HSA - i) * 32 + HeadSub + sign_extend(SlotOffsets[i])
3738  73AB 3A 9C 85         LD A, (Chain0_HeadSlotAbs)
3739  73AE 21 70 80         LD HL, TmpChainIdx
3740  73B1 96               SUB (HL)
3741  73B2 DA 5A 74         JP C, .ucss_invisible                 ; t < 0
3742  73B5 26 00            LD H, 0
3742  73B7 6F             LD L, A
3743  73B8 29               ADD HL, HL
