 541  612D 38 18            JR C, .ug_kz_anim
 542  612F C3 23 62         JP InitGame                       ; auto-restart: InitGame пере-инициализирует всё (GameState=0 сам внутри)
 543  6132
 544  6132              .ug_state3:
 545  6132                  ; State 3 = LEVEL 1-1 intro overlay. Tick counter, после ~150 кадров → state 0 (играем).
 546  6132 3A 17 40         LD A, (GameOverTick)
 547  6135 3C               INC A
 548  6136 32 17 40         LD (GameOverTick), A
 549  6139 FE 96            CP 150                            ; ~3 сек @50fps intro
 550  613B 38 0A            JR C, .ug_kz_anim
