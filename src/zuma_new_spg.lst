5416  7FEE 11 40 00       LD DE, #0040
5416  7FF1 01 C0 00       LD BC, 192
5416  7FF4 ED B0          LDIR
5417  7FF6 21 80 89         LD HL, BgCanvasPalette
5417  7FF9 11 00 01       LD DE, #0100
5417  7FFC 01 00 01       LD BC, 256
5417  7FFF ED B0          LDIR
5418  8001 01 AF 15         LD BC, FMADDR
5418  8004 AF             XOR A
5418  8005 ED 79          OUT (C), A
5419  8007 C9               RET
