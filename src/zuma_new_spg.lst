5229  7ED8              ; ================================================================
5230  7ED8              ; ОБРАБОТКА МЫШИ — абс. позиция курсора + левая кнопка = выстрел
5231  7ED8              ; Kempston Mouse: счётчики X/Y относительные (8-bit wrap), знаковая дельта
5232  7ED8              ; ================================================================
5233  7ED8              ; ================================================================
5234  7ED8              ; APPLY SMOOTH MOUSE — exponential moving average alpha=1/4.
5235  7ED8              ;   smooth = (smooth*3 + raw) / 4
5236  7ED8              ; Раз за кадр после HandleMouse. Inputs: MouseAbsX/Y (16-bit raw, 0..CURSOR_MAX).
5237  7ED8              ; Outputs: SmoothMouseX/Y (16-bit), используется в ComputeFrogAngle / UpdateCursorSprite.
5238  7ED8              ; Гасит ±1-2 px kempston jitter; latency ~3-4 кадра до 95% от raw.
5239  7ED8              ; Источник: VDAC2 → VDC чат 2026-05-09 17:30.
5240  7ED8              ; ================================================================
5241  7ED8              ApplySmoothMouse:
5242  7ED8                  ; --- X: HL = (SmoothX*3 + RawX) / 4 ---
5243  7ED8 2A 60 80         LD HL, (SmoothMouseX)
5244  7EDB 54               LD D, H
5244  7EDC 5D             LD E, L
5245  7EDD 19               ADD HL, DE                ; HL = smooth*2
5246  7EDE 19               ADD HL, DE                ; HL = smooth*3
5247  7EDF ED 5B 5E 80      LD DE, (MouseAbsX)
5248  7EE3 19               ADD HL, DE                ; HL = smooth*3 + raw
5249  7EE4 CB 3C            SRL H
5249  7EE6 CB 1D          RR L
5250  7EE8 CB 3C            SRL H
5250  7EEA CB 1D          RR L              ; HL /= 4
5251  7EEC 22 60 80         LD (SmoothMouseX), HL
5252  7EEF
5253  7EEF                  ; --- Y: HL = (SmoothY*3 + RawY) / 4 ---
5254  7EEF 2A 62 80         LD HL, (SmoothMouseY)
5255  7EF2 54               LD D, H
5255  7EF3 5D             LD E, L
5256  7EF4 19               ADD HL, DE
5257  7EF5 19               ADD HL, DE
5258  7EF6 ED 5B 64 80      LD DE, (MouseAbsY)
5259  7EFA 19               ADD HL, DE
5260  7EFB CB 3C            SRL H
5260  7EFD CB 1D          RR L
5261  7EFF CB 3C            SRL H
5261  7F01 CB 1D          RR L
5262  7F03 22 62 80         LD (SmoothMouseY), HL
5263  7F06 C9               RET
5264  7F07
5265  7F07              HandleMouse:
5266  7F07                  ; Сбрасываем флаг "мышь двигалась" — взводим только при ненулевой дельте
5267  7F07 AF               XOR A
5268  7F08 32 66 80         LD (MouseMoved), A
5269  7F0B
5270  7F0B                  ; --- X (накапливаем абсолютную позицию курсора) ---
5271  7F0B 01 DF FB         LD BC, MOUSE_X
5272  7F0E ED 78            IN A, (C)
5273  7F10 21 5C 80         LD HL, MouseXPrev
5274  7F13 46               LD B, (HL)
5275  7F14 77               LD (HL), A
5276  7F15 90               SUB B               ; A = дельта X (знаковый 8-bit)
5277  7F16 CD AC 7F         CALL ClampDelta     ; |delta|>100 → 0 (фильтр выбросов 8-bit wrap)
5278  7F19 28 07            JR Z, .mx_zero
5279  7F1B F5               PUSH AF
5280  7F1C 3E 01            LD A, 1
5281  7F1E 32 66 80         LD (MouseMoved), A
5282  7F21 F1               POP AF
5283  7F22              .mx_zero:
5284  7F22 5F               LD E, A
5285  7F23 16 00            LD D, 0
5286  7F25 CB 7F            BIT 7, A
5287  7F27 28 01            JR Z, .mx_pos
5288  7F29 15               DEC D
5289  7F2A              .mx_pos:
5290  7F2A 2A 5E 80         LD HL, (MouseAbsX)
5291  7F2D 19               ADD HL, DE
5292  7F2E CB 7C            BIT 7, H
5293  7F30 28 05            JR Z, .mx_hi
5294  7F32 21 00 00         LD HL, 0
5295  7F35 18 10            JR .mx_done
5296  7F37              .mx_hi:
5297  7F37 11 58 01         LD DE, CURSOR_MAX_X
5298  7F3A 7C               LD A, H
5298  7F3B BA             CP D
5298  7F3C 38 09          JR C, .mx_done
5299  7F3E 20 04            JR NZ, .mx_clamp
5300  7F40 7D               LD A, L
5300  7F41 BB             CP E
5300  7F42 38 03          JR C, .mx_done
5301  7F44              .mx_clamp:
5302  7F44 21 58 01         LD HL, CURSOR_MAX_X
5303  7F47              .mx_done:
5304  7F47 22 5E 80         LD (MouseAbsX), HL
5305  7F4A
5306  7F4A                  ; --- Y (накапливаем абсолютную позицию курсора) ---
5307  7F4A 01 DF FF         LD BC, MOUSE_Y
5308  7F4D ED 78            IN A, (C)
5309  7F4F 21 5D 80         LD HL, MouseYPrev
5310  7F52 46               LD B, (HL)
5311  7F53 77               LD (HL), A
5312  7F54 90               SUB B
5313  7F55 ED 44            NEG                 ; Kempston Y: positive=up, invert for screen Y-down
5314  7F57 CD AC 7F         CALL ClampDelta     ; |delta|>100 → 0 (фильтр выбросов 8-bit wrap)
5315  7F5A 28 07            JR Z, .my_zero
5316  7F5C F5               PUSH AF
5317  7F5D 3E 01            LD A, 1
5318  7F5F 32 66 80         LD (MouseMoved), A
5319  7F62 F1               POP AF
5320  7F63              .my_zero:
5321  7F63 5F               LD E, A
5322  7F64 16 00            LD D, 0
5323  7F66 CB 7F            BIT 7, A
5324  7F68 28 01            JR Z, .my_pos
5325  7F6A 15               DEC D
5326  7F6B              .my_pos:
5327  7F6B 2A 64 80         LD HL, (MouseAbsY)
5328  7F6E 19               ADD HL, DE
5329  7F6F CB 7C            BIT 7, H
5330  7F71 28 05            JR Z, .my_hi
5331  7F73 21 00 00         LD HL, 0
5332  7F76 18 10            JR .my_done
5333  7F78              .my_hi:
5334  7F78 11 10 01         LD DE, CURSOR_MAX_Y
5335  7F7B 7C               LD A, H
5335  7F7C BA             CP D
5335  7F7D 38 09          JR C, .my_done
5336  7F7F 20 04            JR NZ, .my_clamp
5337  7F81 7D               LD A, L
5337  7F82 BB             CP E
5337  7F83 38 03          JR C, .my_done
5338  7F85              .my_clamp:
5339  7F85 21 10 01         LD HL, CURSOR_MAX_Y
5340  7F88              .my_done:
5341  7F88 22 64 80         LD (MouseAbsY), HL
5342  7F8B
5343  7F8B                  ; Low-pass фильтр (exp moving avg, alpha=1/4) — гасит kempston jitter ±1-2 px.
5344  7F8B                  ; smooth = (smooth*3 + raw) / 4. Применяется ВСЕГДА (даже когда raw не двигалась)
5345  7F8B                  ; — иначе при остановке курсор «застывает» на raw без сглаживания, видимый микро-jitter.
5346  7F8B CD D8 7E         CALL ApplySmoothMouse
5347  7F8E
5348  7F8E                  ; Повернуть лягушку в сторону курсора — только если мышь двигалась
5349  7F8E 3A 66 80         LD A, (MouseMoved)
5350  7F91 B7               OR A
5351  7F92 C4 1B 64         CALL NZ, ComputeFrogAngle
5352  7F95
5353  7F95                  ; Mouse fire: Unreal Speccy кладёт ЛКМ в бит 0 порта #FADF (а не в бит 1
5354  7F95                  ; как стандарт Kempston). Polarity нормальная: 1=нажата.
5355  7F95                  ; Нарастающий фронт 0→1 = выстрел ровно один раз при нажатии.
5356  7F95 01 DF FA         LD BC, MOUSE_BTN
5357  7F98 ED 78            IN A, (C)
5358  7F9A E6 01            AND %00000001                  ; ЛКМ — бит 0 в Unreal
5359  7F9C 21 67 80         LD HL, MouseBtnPrev
5360  7F9F 46               LD B, (HL)
5361  7FA0 77               LD (HL), A
5362  7FA1 B7               OR A
5363  7FA2 28 07            JR Z, .no_shot                 ; ЛКМ не нажата → ничего
5364  7FA4 78               LD A, B
5365  7FA5 B7               OR A
5366  7FA6 20 03            JR NZ, .no_shot                ; ЛКМ была нажата в прошлом кадре → не первый кадр
5367  7FA8 CD D9 64         CALL ShootBall
5368  7FAB              .no_shot:
5369  7FAB C9               RET
