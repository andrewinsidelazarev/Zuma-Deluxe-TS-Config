3507  7285              ; ================================================================
3508  7285              ; UPDATE STALL BY GAP — ChainStalled=1 если в Slots есть GAP, иначе 0.
3509  7285              ; ================================================================
3510  7285              UpdateStallByGap:
3511  7285                  ; ChainStalled = 1 ТОЛЬКО при наличии GAP-cells (= match-3 в процессе схлопывания).
3512  7285                  ; Раньше также stall'илось при non-zero offsets («анимация в процессе») — это давало
3513  7285                  ; +32 кадра паузы поверх ChainFreezeCounter после ЛЮБОГО insert (без match), т.к.
3514  7285                  ; head комп offsets[0..idx-1]=-32 декаит 32 кадра, всё это время stall=1, freeze
3515  7285                  ; counter даже не декрементируется. Итого суммарная пауза ~1.1 сек = жалоба
3516  7285                  ; «трек останавливается при попадании». Python `update_stall` просто `s.chain_stalled=0`
3517  7285                  ; всегда; ChainFreezeCounter сам по себе уже даёт нужную паузу 32 кадра.
3518  7285 3A 9E 85         LD A, (Chain0_SlotsLen)
3519  7288 B7               OR A
3520  7289 28 0C            JR Z, .usg_no_activity
3521  728B 47               LD B, A
3522  728C 21 EC 80         LD HL, Chain0_Slots
3523  728F              .usg_slots_loop:
3524  728F 7E               LD A, (HL)
3525  7290 FE 06            CP NUM_BALL_COLORS
3526  7292 30 08            JR NC, .usg_has_activity                  ; GAP найден → stall
3527  7294 23               INC HL
3528  7295 10 F8            DJNZ .usg_slots_loop
3529  7297              .usg_no_activity:
3530  7297 AF               XOR A
3531  7298 32 75 80         LD (ChainStalled), A
3532  729B C9               RET
3533  729C              .usg_has_activity:
3534  729C 3E 01            LD A, 1
3535  729E 32 75 80         LD (ChainStalled), A
3536  72A1 C9               RET
