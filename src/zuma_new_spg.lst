1841  694D 2A 43 80         LD HL, (ChainColorSeed)
1842  6950 57               LD D, A                               ; D = RTC sec
1843  6951 5F               LD E, A                               ; multiplier as DE
1844  6952 7D               LD A, L                               ; A = low seed byte
1845  6953 21 00 00         LD HL, 0
1846  6956 06 08            LD B, 8
