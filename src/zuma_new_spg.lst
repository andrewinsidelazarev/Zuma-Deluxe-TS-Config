4005  754D 01 AF 15         LD BC, FMADDR
4005  7550 3E 10          LD A, FM_EN
4005  7552 ED 79          OUT (C), A
4006  7554 21 14 00         LD HL, TEXT_X
4007  7557 22 19 40         LD (TmpGoX), HL
4008  755A AF               XOR A
4009  755B 32 1B 40         LD (TmpGoTNumOffs), A
4010  755E 21 18 02         LD HL, DESC_CHAIN0
4011  7561 06 05            LD B, TEXT_NUM_SPRITES
4012  7563              .dto_loop:
4013  7563 36 70            LD (HL), LOW(TEXT_Y)
4013  7565 23             INC HL
4014  7566 36 2E            LD (HL), HIGH(TEXT_Y) | SPACT | SPSIZ64
4014  7568 23             INC HL    ; Y_H + ACT + SIZE64 vert
4015  7569
4016  7569 3A 19 40         LD A, (TmpGoX)
4017  756C 77               LD (HL), A
4017  756D 23             INC HL                                  ; X_L
4018  756E 3A 1A 40         LD A, (TmpGoX+1)
4019  7571 E6 01            AND 1
4020  7573 F6 0E            OR SPSIZ64
4021  7575 77               LD (HL), A
4021  7576 23             INC HL                                  ; X_H + SIZE64 horiz
4022  7577
4023  7577 3A 1B 40         LD A, (TmpGoTNumOffs)
4024  757A ED 5B 1C 40      LD DE, (TmpGoTNumBase)
4025  757E 83               ADD A, E
4026  757F 77               LD (HL), A
4026  7580 23             INC HL                                  ; TNUM_L = base_low + offset
4027  7581 7A               LD A, D
4028  7582 E6 0F            AND #0F
4029  7584 F6 50            OR TEXT_SPAL << 4                                    ; SPAL upper nibble
4030  7586 77               LD (HL), A
4030  7587 23             INC HL                                  ; TNUM_H | SPAL<<4
4031  7588
4032  7588 E5               PUSH HL
4033  7589 2A 19 40         LD HL, (TmpGoX)
4034  758C 11 40 00         LD DE, TEXT_SPRITE_W
4035  758F 19               ADD HL, DE
4036  7590 22 19 40         LD (TmpGoX), HL
4037  7593 3A 1B 40         LD A, (TmpGoTNumOffs)
4037  7596 C6 08          ADD A, 8
4037  7598 32 1B 40       LD (TmpGoTNumOffs), A
4038  759B E1               POP HL
