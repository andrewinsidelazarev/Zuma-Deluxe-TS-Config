4244  7761
4245  7761                  ; flag = SkipFlag[i]
4246  7761 26 00            LD H, 0
4246  7763 6F             LD L, A
4247  7764 11 7E 49         LD DE, BcsSkipFlag
4248  7767 19               ADD HL, DE
