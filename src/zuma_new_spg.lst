1970  69ED 7D               LD A, L                               ; A = random low byte
1971  69EE 21 3F 80         LD HL, LevelNumColors
1972  69F1 5E               LD E, (HL)
1973  69F2 16 00            LD D, 0
1974  69F4 21 00 00         LD HL, 0
