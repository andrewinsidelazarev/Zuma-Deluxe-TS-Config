3836  7483              ; ================================================================
3837  7483              ; LOAD BALLS DMA PALETTE — копирует 32 CRAM word из BallsDmaPalette
3838  7483              ; в FM-mapped CRAM byte offset 256 (= CRAM #80..#9F).
3839  7483              ; ================================================================
3840  7483              LoadBallsDmaPalette:
3841  7483 01 AF 15         LD BC, FMADDR
3841  7486 3E 10          LD A, FM_EN
3841  7488 ED 79          OUT (C), A
3842  748A 21 80 8A         LD HL, BallsDmaPalette
3843  748D 11 C0 01         LD DE, #01C0                              ; CRAM #E0 word = byte offset 448 = #01C0
3844  7490 01 40 00         LD BC, 64                                 ; 32 words × 2 byte
3845  7493 ED B0            LDIR
3846  7495 01 AF 15         LD BC, FMADDR
3846  7498 AF             XOR A
3846  7499 ED 79          OUT (C), A
3847  749B C9               RET
