4271  778C 32 00 40       LD (BcsDstLow),    A
4271  778F 23             INC HL
4272  7790 7E               LD A, (HL)
4272  7791 32 01 40       LD (BcsDstMid),    A
4272  7794 23             INC HL
4273  7795 7E               LD A, (HL)
4273  7796 32 02 40       LD (BcsPageOver),  A
4273  7799 23             INC HL
4274  779A 7E               LD A, (HL)
4274  779B 32 09 40       LD (BcsNumLines),  A
4274  779E 23             INC HL
4275  779F 7E               LD A, (HL)
4275  77A0 32 07 40       LD (BcsClipTop),   A
4275  77A3 23             INC HL
4276  77A4 7E               LD A, (HL)
4276  77A5 32 0A 40       LD (BcsXOdd),      A
4277  77A8
4278  77A8                  ; --- DMA setup: NumLines-1, src offset = ClipTop*512 ---
4279  77A8 3A 09 40         LD A, (BcsNumLines)
4279  77AB 3D             DEC A
4279  77AC 01 AF 28       LD BC, DMANUM
4279  77AF ED 79          OUT (C), A
4280  77B1 AF               XOR A
4280  77B2 01 AF 1A       LD BC, DMASADL
4280  77B5 ED 79          OUT (C), A
4281  77B7 3A 07 40         LD A, (BcsClipTop)
4282  77BA 87               ADD A, A                                  ; src_high = ClipTop * 2
4283  77BB 01 AF 1B         LD BC, DMASADH
4283  77BE ED 79          OUT (C), A
4284  77C0
4285  77C0                  ; --- src page: (XOdd ? ODD : EVEN) + color ---
4286  77C0 3A 70 80         LD A, (TmpChainIdx)
4287  77C3 26 00            LD H, 0
4287  77C5 6F             LD L, A
4288  77C6 11 EC 80         LD DE, Chain0_Slots
4289  77C9 19               ADD HL, DE
4290  77CA 7E               LD A, (HL)
