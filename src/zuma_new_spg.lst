4076  75DB 21 40 00         LD HL, TEXT_SPRITE_W                                 ; +64 px
4077  75DE 19               ADD HL, DE
4078  75DF EB               EX DE, HL                                            ; DE = new X
4079  75E0 E1               POP HL
4080  75E1 10 D5            DJNZ .dst_loop
4081  75E3 01 AF 15         LD BC, FMADDR
4081  75E6 AF             XOR A
