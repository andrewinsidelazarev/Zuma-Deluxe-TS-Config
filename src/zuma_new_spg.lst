5371  7FAC              ; ================================================================
5372  7FAC              ; ClampDelta — фильтр выбросов от 8-bit wrap Kempston Mouse
5373  7FAC              ; Вход:  A = знаковая дельта (-128..127)
5374  7FAC              ; Выход: A = A если |A|<=100, иначе 0. Z флаг отражает результат.
5375  7FAC              ; Сохраняет: BC, DE, HL.
5376  7FAC              ; ================================================================
5377  7FAC              ClampDelta:
5378  7FAC                  ; В fullscreen mouse capture wrap почти не возникает — порог поднят до 127.
5379  7FAC                  ; Так что фактически фильтр пропускает любую дельту, оставаясь как safety.
5380  7FAC B7               OR A
5381  7FAD C8               RET Z
5382  7FAE C5               PUSH BC
5383  7FAF 4F               LD C, A
5384  7FB0 CB 7F            BIT 7, A
5385  7FB2 28 0A            JR Z, .cd_pos
5386  7FB4 ED 44            NEG
5387  7FB6 FE 80            CP 128
5388  7FB8 30 0B            JR NC, .cd_zero
5389  7FBA 79               LD A, C
5390  7FBB C1               POP BC
5391  7FBC B7               OR A
5392  7FBD C9               RET
5393  7FBE              .cd_pos:
5394  7FBE FE 80            CP 128
5395  7FC0 30 03            JR NC, .cd_zero
5396  7FC2 C1               POP BC
5397  7FC3 B7               OR A
5398  7FC4 C9               RET
5399  7FC5              .cd_zero:
5400  7FC5 C1               POP BC
5401  7FC6 AF               XOR A
5402  7FC7 C9               RET
