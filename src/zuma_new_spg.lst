 558  614A C9               RET
 559  614B
 560  614B              ; ============================================================================
 561  614B              ; RENDER FRAME — atomic swap + все DMA/TSU writes.
 562  614B              ; Вызывается раз когда вся логика догнала тики.
 563  614B              ; ============================================================================
 564  614B              RenderFrame:
 565  614B                  ; ====== CANARY CHECK: stack overflow detection ======
 566  614B                  ; Если stack overflowed past 0xC800, "ZUM" затёрт. Visible-error через CRAM #100=red.
 567  614B 3A 00 C8         LD A, (#C800)
 568  614E FE 5A            CP 'Z'
 569  6150 20 0E            JR NZ, .canary_failed
 570  6152 3A 01 C8         LD A, (#C801)
 571  6155 FE 55            CP 'U'
 572  6157 20 07            JR NZ, .canary_failed
 573  6159 3A 02 C8         LD A, (#C802)
 574  615C FE 4D            CP 'M'
 575  615E 28 17            JR Z, .canary_ok
 576  6160              .canary_failed:
 577  6160                  ; Hard-fail: записать ярко-красный pixel в CRAM #100 (= bg palette idx 0 = pavement bg)
 578  6160                  ; Юзер увидит красный bg → сразу понятно что stack overflowed.
 579  6160 01 AF 15         LD BC, FMADDR
 579  6163 3E 10          LD A, FM_EN
 579  6165 ED 79          OUT (C), A
 580  6167 3E 1F            LD A, %00011111
 580  6169 32 00 01       LD (#0100), A           ; CRAM word low: B=11111, G=000, ?
 581  616C 3E FC            LD A, %11111100
 581  616E 32 01 01       LD (#0101), A           ; CRAM high: bit15=1, R=11111, G_hi=000
 582  6171 01 AF 15         LD BC, FMADDR
 582  6174 AF             XOR A
 582  6175 ED 79          OUT (C), A
 583  6177              .canary_ok:
 584  6177
 585  6177                  ; ====== СВОП BUFFER (atomic) ======
 586  6177 3A 13 40         LD A, (VisiblePageBase)
 586  617A EE 30          XOR #30
 586  617C 32 13 40       LD (VisiblePageBase), A
 587  617F 3A 14 40         LD A, (ShadowPageBase)
 587  6182 EE 30          XOR #30
 587  6184 32 14 40       LD (ShadowPageBase), A
 588  6187 3A 13 40         LD A, (VisiblePageBase)
 588  618A 01 AF 01       LD BC, VPAGE
 588  618D ED 79          OUT (C), A
 589  618F
 590  618F                  ; DEBUG pixel удалён — PAGE3 теперь зарезервирован под TrackData spillover (page #60).
 591  618F                  ; Если нужна диагностика — использовать дамп памяти (#C000+ читает TrackData
 592  618F                  ; spillover, переменные доступны напрямую через addresses в .lst).
 593  618F
 594  618F                  ; TSU writes сгруппированы early — в vblank, до DMA blits.
 595  618F CD 76 67         CALL UpdateFrogSprite
 596  6192 CD 87 7D         CALL UpdatePreviewSprite
 597  6195 CD D6 67         CALL UpdateBallSprites
 598  6198 CD 20 7B         CALL HideChainSprites                    ; chain рендерится DMA (partial-clip для entry-zone),
 599  619B                                                           ; TSU descriptors просто off-screen чтобы не висели stale.
 600  619B CD 47 7B         CALL UpdateExplodeSprites                ; перенесён early — иначе race с display refresh
 601  619E CD 57 7D         CALL UpdateCursorSprite
 602  61A1 CD 02 7D         CALL UpdateKzSkullSprite                 ; skull frame TNUM = base + KzFrame*4 (10 frames lose anim)
 603  61A4                  ; Текстовые overlay рендерятся из page #0D (single 16K atlas, реконфигурируется
 604  61A4                  ; DMA-копией при переходах состояний — см. CopyAtlasToPageD).
 605  61A4                  ; Initial content = LEVEL 1-1 + SPIRAL OF DOOM (= InitGame копирует level_intro).
 606  61A4                  ; State 1→2 transition копирует GAME OVER → page #0D.
 607  61A4 3A 15 40         LD A, (GameState)
 608  61A7 FE 02            CP 2
 609  61A9 CC 3C 75         CALL Z, UpdateGameOverText               ; state 2: GAME OVER overlay
 610  61AC 3A 15 40         LD A, (GameState)
 611  61AF FE 03            CP 3
 612  61B1 CC 41 75         CALL Z, UpdateLevelIntroText             ; state 3: LEVEL 1-1 + SPIRAL OF DOOM
 613  61B4 CD C0 79         CALL BlitKillzoneToShadow                ; kz first — chain DMA blit'ит шары ПОВЕРХ kz pixels.
 614  61B7 CD 97 76         CALL BlitChainToShadow                   ; PASS1 restore читает golden (track+kz после OneTimeBlitKzToGolden
 615  61BA                                                           ; в init), prev ball positions в kz-зоне восстанавливаются с kz pixels,
 616  61BA                                                           ; не track-цветом → нет «дыр» в kz.
 617  61BA C9               RET
 618  61BB
 619  61BB              ; ================================================================
 620  61BB              ; DIAGNOSTIC GRID — пишет 60 TSU destroy-спрайтов в DESC_CHAIN0 в виде сетки 6×10.
 621  61BB              ; Чтобы увидеть где TSU layer 1 рендерится корректно по всему экрану.
 622  61BB              ; Шаг X = 56 px (= 6 cols × 56 = 336 — ~центр canvas 360).
 623  61BB              ; Шаг Y = 28 px (= 10 rows × 28 = 280 — ~центр canvas 288).
 624  61BB              ; Frame 0, SPAL=2 (синий).
 625  61BB              ; ================================================================
 626  61BB              DiagnosticGrid:
 627  61BB F3               DI
 628  61BC 01 AF 15         LD BC, FMADDR
 628  61BF 3E 10          LD A, FM_EN
 628  61C1 ED 79          OUT (C), A
 629  61C3 21 18 02         LD HL, DESC_CHAIN0
 630  61C6 06 00            LD B, 0                                   ; row counter (0..9)
 631  61C8              .dg_row:
 632  61C8 0E 00            LD C, 0                                   ; col counter (0..5)
 633  61CA              .dg_col:
 634  61CA                  ; Y = row * 28
 635  61CA 78               LD A, B
 636  61CB 57               LD D, A
 636  61CC 87             ADD A, A
 636  61CD 87             ADD A, A
 636  61CE 87             ADD A, A  ; A = row*8
 637  61CF 87               ADD A, A                                  ; A = row*16
 638  61D0 82               ADD A, D                                  ; A = row*16 + row = row*17? OEPS
 639  61D1                  ; нужно row*28. Простой способ: row*32 - row*4.
 640  61D1 78               LD A, B
 641  61D2 87               ADD A, A
 641  61D3 87             ADD A, A
 641  61D4 87             ADD A, A
 641  61D5 87             ADD A, A
 641  61D6 87             ADD A, A   ; row*32
 642  61D7 57               LD D, A
 643  61D8 78               LD A, B
 644  61D9 87               ADD A, A
 644  61DA 87             ADD A, A                       ; row*4
 645  61DB 5F               LD E, A
 646  61DC 7A               LD A, D
 647  61DD 93               SUB E                                     ; A = row*32 - row*4 = row*28
 648  61DE 77               LD (HL), A
 648  61DF 23             INC HL                       ; Y_L
 649  61E0 36 22            LD (HL), SPACT + SPSIZ16                  ; Y_H=0, ACT, SIZE16
 650  61E2 23               INC HL
 651  61E3
 652  61E3                  ; X = col * 40 + 28 (max col=5: X = 228, < 256 — fits в byte без X[8])
 653  61E3 79               LD A, C
 654  61E4 87               ADD A, A
 654  61E5 87             ADD A, A
 654  61E6 87             ADD A, A            ; col*8
 655  61E7 57               LD D, A
 656  61E8 79               LD A, C
 657  61E9 87               ADD A, A
 657  61EA 87             ADD A, A
 657  61EB 87             ADD A, A
 657  61EC 87             ADD A, A
 657  61ED 87             ADD A, A   ; col*32
 658  61EE 82               ADD A, D                                  ; col*32 + col*8 = col*40
