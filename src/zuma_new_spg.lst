 342  500E              ; ================================================================
 343  500E              ; КОД
 344  500E              ; ================================================================
 345  500E                  ORG #6000
 346  6000
 347  6000              Entry:
 348  6000 F3               DI
 349  6001                  ; PAGE3 = #0C ПЕРВЫМ — чтобы stack at 0xFFFE сразу попал в page #0C (= safe zone
 350  6001                  ; в page #0C bytes 0x800..0x3FFF, после track_overflow.bin = 0..0x7FF). Иначе
 351  6001                  ; PAGE3=0 default → stack пишет в ROM/garbage page.
 352  6001 3E 0C            LD A, #0C
 353  6003 01 AF 13         LD BC, PAGE3
 354  6006 ED 79            OUT (C), A
 355  6008
 356  6008                  ; Stack в slot 3 (= 0xC800..0xFFFE = 14KB safe zone, не пересекается с TrackData).
 357  6008                  ; Раньше был SP=#BFFF — стек растил ВНИЗ в TrackData (0x969C..0xBFFF) и затирал
 358  6008                  ; точки 2643..2648 → glitch у головного шара ровно на (58, 103) (= "false killzone V7").
 359  6008 31 FE FF         LD SP, #FFFE
 360  600B
 361  600B                  ; --- Canary marker: 3 bytes "ZUM" at 0xC800 (= start of safe stack zone).
 362  600B                  ; Если stack overflowed past 0xC800, canary будет затёрт. RenderFrame проверяет.
 363  600B 3E 5A            LD A, 'Z'
 363  600D 32 00 C8       LD (#C800), A
 364  6010 3E 55            LD A, 'U'
 364  6012 32 01 C8       LD (#C801), A
 365  6015 3E 4D            LD A, 'M'
 365  6017 32 02 C8       LD (#C802), A
 366  601A
 367  601A                  ; ---------- ИНИЦИАЛИЗАЦИЯ ЖЕЛЕЗА ----------
 368  601A 01 AF 20         LD BC, SYSCONG
 368  601D 3E 06          LD A, %00000110
 368  601F ED 79          OUT (C), A     ; 14 MHz + аппаратный кэш
 369  6021 01 AF 00         LD BC, VCONFIG
 369  6024 3E C2          LD A, %11000010
 369  6026 ED 79          OUT (C), A  ; 360x288, 256c, NOGFX=0 — canvas включён
 370  6028 01 AF 01         LD BC, VPAGE
 370  602B 3E 10          LD A, #10
 370  602D ED 79          OUT (C), A  ; canvas-bitmap начинается с page 16
 371  602F
 372  602F                  ; Палитра (включая bg-canvas палитру в CRAM #0100..#01FF)
 373  602F                  ; DMA-шары используют TSU-палитру (#20..#7F) — отдельная загрузка не нужна
 374  602F CD C8 7F         CALL InitPalette
 375  6032
 376  6032                  ; TSU — sprite-graphics в page 6/7 (уже разложены через INCBIN)
 377  6032 01 AF 19         LD BC, SGPAGE
 377  6035 3E 06          LD A, 6
 377  6037 ED 79          OUT (C), A
 378  6039 01 AF 06         LD BC, TSCONFIG
 378  603C 3E 80          LD A, %10000000
 378  603E ED 79          OUT (C), A   ; TSU sprites вкл
 379  6040
 380  6040                  ; ---------- ИНИЦИАЛИЗАЦИЯ ИГРЫ ----------
 381  6040 CD 23 62         CALL InitGame
 382  6043
 383  6043                  ; Burn killzone в golden ОДИН раз (= bg для chain DMA restore содержит track+kz).
 384  6043 CD 1F 75         CALL OneTimeBlitKzToGolden
 385  6046
 386  6046                  ; ---------- IM 2 + frame IRQ для Fixed Timestep ----------
 387  6046                  ; ISR-handler в page 5 (наш код). I=#5E, peripheral data byte для frame IRQ
 388  6046                  ; (= INTRAME=#FF). Vector address = (#5E<<8)|#FF = #5EFF. Z80 читает word
 389  6046                  ; #5EFF/#5F00 → ISR address. Записываем эти 2 байта runtime, чтобы получить
 390  6046                  ; адрес IRQHandler в RAM (page 5 byte #1EFF/#1F00).
 391  6046 3E 17            LD A, LOW(IRQHandler)
 392  6048 32 FF 5E         LD (#5EFF), A
 393  604B 3E 62            LD A, HIGH(IRQHandler)
 394  604D 32 00 5F         LD (#5F00), A
 395  6050 3E 5E            LD A, #5E
 396  6052 ED 47            LD I, A
 397  6054 ED 5E            IM 2
 398  6056 01 AF 2A         LD BC, INTMASK
 398  6059 3E 01          LD A, INTMSKF
 398  605B ED 79          OUT (C), A    ; разрешить только frame IRQ
 399  605D AF               XOR A
 399  605E 32 72 80       LD (TickCount), A
 399  6061 32 73 80       LD (ProcessedTicks), A
 400  6064 FB               EI
 401  6065
 402  6065              ; ============================================================================
 403  6065              ; FIXED TIMESTEP MAIN LOOP
 404  6065              ; ISR инкрементирует TickCount каждый vblank (50 Hz). MainLoop "догоняет":
 405  6065              ; пока ProcessedTicks < TickCount → выполнить UpdateGame + INC ProcessedTicks.
 406  6065              ; Когда тики обработаны — RenderFrame (swap+sprites+DMA blit) и HALT (sleep).
 407  6065              ; Если кадр рендера затянулся (>20мс) — успело пройти 2+ IRQ → следующий цикл
 408  6065              ; выполнит UpdateGame дважды → game speed остаётся 50 Hz, рендер визуально 25.
 409  6065              ; Никаких race conditions: вся логика атомарна в MainLoop, ISR только тик.
 410  6065              ; ============================================================================
 411  6065              MainLoop:
 412  6065 F3               DI
 413  6066 3A 72 80         LD A, (TickCount)
 414  6069 47               LD B, A
 415  606A 3A 73 80         LD A, (ProcessedTicks)
 416  606D FB               EI
 417  606E B8               CP B
 418  606F 28 09            JR Z, .ml_render
 419  6071 CD 80 60         CALL UpdateGame
 420  6074 21 73 80         LD HL, ProcessedTicks
 421  6077 34               INC (HL)
 422  6078 18 EB            JR MainLoop
 423  607A              .ml_render:
 424  607A CD 4B 61         CALL RenderFrame
 425  607D 76               HALT                                      ; сон до следующего IRQ
 426  607E 18 E5            JR MainLoop
 427  6080
 428  6080              ; ============================================================================
 429  6080              ; UPDATE GAME — атомарный шаг логики (= 1 tick = 20 мс).
 430  6080              ; Mouse/input, motion, collisions, chain advance, spawn, cooldown.
 431  6080              ; НЕ trogает canvas / DMA / TSU спрайты — это в RenderFrame.
 432  6080              ; ============================================================================
 433  6080              UpdateGame:
 434  6080 3A 15 40         LD A, (GameState)
 435  6083 B7               OR A
 436  6084 C2 F6 60         JP NZ, .ug_not_playing            ; state 1/2 — отдельные пути
 437  6087
 438  6087 CD 07 7F         CALL HandleMouse
 439  608A CD E1 63         CALL HandleInput
 440  608D CD EB 64         CALL UpdateBalls
 441  6090 CD EF 66         CALL CheckCollisions
 442  6093 CD 80 6D         CALL CheckBallChainCollisions
 443  6096
 444  6096 3A 71 80         LD A, (FrameCounter)
 445  6099 3C               INC A
 446  609A 32 71 80         LD (FrameCounter), A
 447  609D
 448  609D 3A 74 80         LD A, (BallsSpawned)
 449  60A0 FE 23            CP LEVEL_START_BALLS
 450  60A2 38 20            JR C, .ug_fast
 451  60A4
 452  60A4                  ; TEMP REVERT: subdivider /2 вернён для диагностики trail-bug в DMA chain blit.
 453  60A4                  ; Если без subdivider trail visible (= motion 1 px/frame), а с subdivider — нет
 454  60A4                  ; (= motion 0.5 px/frame), root cause = pre-existing render race triggered by speed.
 455  60A4 3A 71 80         LD A, (FrameCounter)
 456  60A7 E6 01            AND 1
 457  60A9 20 06            JR NZ, .ug_after_advance
 458  60AB CD A2 72         CALL MoveChain
 459  60AE CD B3 6F         CALL AnimateChain
 460  60B1              .ug_after_advance:
 461  60B1
 462  60B1 3A 74 80         LD A, (BallsSpawned)
 463  60B4 FE 55            CP LEVEL_TOTAL_BALLS
 464  60B6 30 0A            JR NC, .ug_no_more_spawn
 465  60B8 3A 71 80         LD A, (FrameCounter)
 466  60BB E6 3F            AND 63
 467  60BD 20 03            JR NZ, .ug_no_more_spawn
 468  60BF CD 54 68         CALL TrySpawnAndCount
 469  60C2              .ug_no_more_spawn:
 470  60C2 18 0F            JR .ug_check_trigger
 471  60C4
 472  60C4              .ug_fast:
 473  60C4 06 0C            LD B, FAST_ADVANCE
 474  60C6              .ug_fast_advance:
