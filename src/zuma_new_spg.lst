 153  0000              MAX_BALLS     EQU 8             ; летящих шаров (cooldown 20 frames → max ~3 active одновременно;
 154  0000                                              ; уменьшено с 16 чтобы освободить SFILE для chain TSU расширения)
 155  0000              MAX_CHAIN_BALLS EQU 240         ; VDC chain physics limit. HD оригинал: 256. У нас 240 чтобы
 156  0000                                              ; TrackData (12386 байт) поместился в slot 2 (16K) без spillover.
 157  0000                                              ; Если перенести TrackData на свою page — можно поднять до 255.
 158  0000              TSU_CHAIN_SPRITES EQU 70        ; зарезервированных SFILE-дескрипторов для chain TSU layer 1.
 159  0000                                              ; Bumped 60→70 чтобы tail не уходил за лимит при insert (= шар пропадал
 160  0000                                              ; визуально когда chain рос с 60 до 61). 70 покрывает realistic max.
 161  0000                                              ; SFILE max 85 descriptors; layout: 4 frog/preview/cursor + 8 balls + 70 chain = 82 ≤ 85.
 162  0000
 163  0000              ; Параметры уровня (level1 / lvl11 в оригинальной Zuma):
 164  0000              LEVEL_START_BALLS  EQU 35       ; быстрая фаза: 35 шаров вылезают «поездом»
 165  0000              LEVEL_REPEAT_BALLS EQU 50       ; нормальная фаза: ещё 50 шаров обычной скоростью
 166  0000              LEVEL_TOTAL_BALLS  EQU LEVEL_START_BALLS + LEVEL_REPEAT_BALLS  ; 85 — после спавн прекращается
 167  0000              FAST_ADVANCE       EQU 12       ; кол-во MoveChain'ов за кадр в fast-фазе (norm = 1 за 2 кадра)
 168  0000              ; --- Размер шара и cell-spacing (см. также make_dma_balls.py: BALL_PIX) ---
 169  0000              BALL_DIAMETER      EQU 20       ; диаметр DMA-копии (= 10 words x 20 lines). Visible круг = 18-19 px (radius 9.5 в png-маске).
 170  0000              CELL_SIZE          EQU 32       ; шаг между cell-позициями (в семплах трека).
 171  0000                                              ; cell-step px = TrackLen / TRACK_NUM_SLOTS ~= 1986/96 ~= 20.7.
 172  0000                                              ; Уменьшить до 18..24 если хотим плотнее.
 173  0000              CHAIN_SPACING      EQU CELL_SIZE  ; legacy alias
 174  0000
 175  0000              ; ----- VDC (Virtual Discrete Chain) — текущая модель цепочки
 176  0000              ;
 177  0000              ; Каждый физический трек уровня имеет свой ChainStateBlock. Сейчас один (Chain0).
 178  0000              ; В оригинальной Zuma бывают уровни с двумя tracks → потребуется Chain1_*.
 179  0000              ; Slot k (целое 0..SlotsLen-1) — ячейка вдоль трека на t-позиции k*CELL_SIZE.
 180  0000              ; Координаты берутся из TrackData[t] напрямую — отдельный CellTable не нужен.
 181  0000              ;
 182  0000              ; Chain0_Slots[k] хранит цвет (0..NUM_BALL_COLORS-1) либо GAP-маркер (>= NUM_BALL_COLORS).
 183  0000              ; Chain0_SlotOffsets[k] — signed sub-cell delta (-128..+127) для smooth animation
 184  0000              ;   при match/insert/cascade compactify; общее движение — discrete по cell-grid.
 185  0000              ; Chain0_HeadSlotAbs — абсолютный track-slot для Chain0_Slots[0] (head).
 186  0000              ; Chain0_HeadSub — sub-cell (0..CELL_SIZE-1) для непрерывного движения head'а.
 187  0000              ; Chain0_SlotsLen — длина active range (head..tail включительно).
 188  0000              ;
 189  0000              ; t-позиция шара в slot k:
 190  0000              ;   t = (Chain0_HeadSlotAbs - k) * CELL_SIZE + Chain0_HeadSub + Chain0_SlotOffsets[k]
 191  0000              ;
 192  0000              ; Match-3 detect: window-3 scan по Chain0_Slots[]. s[k]==s[k+1]==s[k+2] && s[k] color → match.
 193  0000              ; Match-3 apply: Slots[lb..rb] := GAP_STOP, ChainStalled=1, GapStep начинает закрывать.
 194  0000              ; --- VDC GAP-маркеры (виртуальные цвета). Любой Slots[k] >= NUM_BALL_COLORS = GAP. ---
 195  0000              GAP_STOP            EQU #FE   ; после stop-mode match. Двигается вправо (к tail в массиве).
 196  0000              GAP_CASCADE         EQU #FD   ; после cascade-mode match. Двигается влево (к head).
 197  0000              GAP_MARKER          EQU GAP_STOP    ; legacy alias (init/render/scan не различают)
 198  0000              MAX_SLOTS_PER_CHAIN EQU MAX_CHAIN_BALLS  ; 60: совместимо с ChainPrev*[] arrays
 199  0000              NUM_BALL_COLORS     EQU 6                ; max доступных цветов (compile-time, для array sizes / GAP detect).
 200  0000                                                      ; Реальное число цветов на уровне берётся из LevelNumColors (runtime).
 201  0000              GAP_STEP_FRAMES     EQU CELL_SIZE        ; кадров на 1 cell-step (= 32 frames per cell @ 1 px/frame decay)
 202  0000              EXPLOSION_FRAMES    EQU 14               ; длительность explosion-анимации до перехода в GAP_STOP
 203  0000              EXPLOSION_HIDE_AT   EQU 1                ; с какого ExplodingFrame DMA-шар скрывается (с самого начала, рисуем destroy через TSU)
 204  0000              DESTROY_BASE_TNUM   EQU 2560             ; page 11 (#B) carpet row 40, normal variant. Frame N TNUM = base + N*2.
 205  0000              DESTROY_SHIFTED_OFFSET EQU 128           ; +2 carpet rows (= 64*2 cells) для shifted-up variant (используется при trackY<8)
 206  0000              NUM_DESTROY_FRAMES  EQU 7                ; frames в destroy_gfx.bin
 207  0000              DM3_OFFSET_GAP_MAX  EQU 8                ; макс. |offset diff| между соседями run'а в DetectMatch3
 208  0000                                                        ; (= визуальная зазора, при котором ещё считаем что шары
 209  0000                                                        ; «коснулись». При большем — match НЕ считается, ждём
 210  0000                                                        ; пока offset decay сведёт зазор. Полу-ball width = 9 px.)
 211  0000
 212  0000              ; BlitChainToShadow per-slot classification (заполняется в BcsPreClassify, читается PASS1/PASS2).
 213  0000              ; PRESERVE значит «оставить шар в shadow как есть» — фикс хвоста при cascade roll-back.
 214  0000              BCS_DRAW            EQU 0    ; нормальный blit (есть кэш геометрии)
 215  0000              BCS_DESTROY         EQU 1    ; шар удалён (i>=SlotsLen / GAP) → restore golden, prev → invalid
 216  0000              BCS_PRESERVE        EQU 2    ; off-track / off-canvas → shadow не трогаем, prev не invalid'им
 217  0000
 218  0000              ; Killzone (череп с лучами в конце трека) — DMA blit 64×64 на canvas.
 219  0000              ; 64x64 при stride 512 = 32K → разбит на 2 src pages: top rows 0..31, bot 32..63.
 220  0000              ; Killzone — sun base в pages #46/#47 (DMA single static frame, не анимируется).
 221  0000              ; Skull рендерится отдельно через TSU sprite layer 1, atlas в page #0D.
 222  0000              ; KzFrame теперь = TSU sprite frame index (0..9), управляет TNUM в DESC_KZSKULL.
 223  0000              KILLZONE_DMA_PAGE_TOP EQU #46
 224  0000              KILLZONE_DMA_PAGE_BOT EQU #47
 225  0000              KZ_SKULL_TNUM_BASE    EQU 2816  ; page_b (#0B) cy=4: (#0B-#06)*512 + 4*64 = 2560+256 = 2816
 226  0000              KZ_SKULL_SPAL         EQU 4     ; CRAM #40..#4F (yellow palette)
 227  0000              ; Offset для skull относительно KzCenter (= track end). Sun имеет hole offset от
 228  0000              ; визуального центра — корректируем здесь чтобы skull аккурат в центр sun-дырки.
 229  0000              KZ_SKULL_X_OFFS       EQU 2     ; +2 px right
 230  0000              KZ_SKULL_Y_OFFS       EQU 0
 231  0000              KZ_NUM_FRAMES         EQU 10
 232  0000              KZ_FRAME_DELAY        EQU 4     ; кол-во game frames между transitions (= ~12 fps анимации)
 233  0000              KZ_OPEN_DIST          EQU 96    ; trackpoint distance до kz, при котором рот начинает открываться (= 3 cells × 32)
 234  0000
 235  0000              ; Text overlays — GAME OVER + LEVEL INTRO. Один общий atlas-page #0D, контент
 236  0000              ; в нём перезаписывается DMA-копией из source-страниц при смене состояния:
 237  0000              ;   GAMEOVER_ATLAS_SRC_PAGE → #0D на state 1→2 transition
 238  0000              ;   LVLINTRO_ATLAS_SRC_PAGE → #0D в InitGame (для state 3 intro)
 239  0000              ; Source-страницы вне reach SGPAGE=6, но это OK — TSU читает только #0D.
 240  0000              ; LEVEL 1-1 — 5×64×64 в cx=0..39 cy=0..7 (TNUM 3584 + N*8).
 241  0000              ; SPIRAL OF DOOM — 5×64×32, scattered в cx=40..63 cy=0..7 (TNUMs 3624, 3632, 3640, 3880, 3888).
 242  0000              ; GAME OVER — 5×64×64 в cx=0..39 cy=0..7 (TNUM 3584 + N*8, как LEVEL 1-1).
 243  0000              ; SPAL=5 (custom red→yellow gradient palette).
 244  0000              GAMEOVER_TNUM_BASE    EQU 3584   ; page #0D, cx=0..39 cy=0..7 после DMA-swap GAME OVER
 245  0000              LVLINTRO_TNUM_BASE    EQU 3584   ; page #0D, cx=0..39 cy=0..7 после DMA-swap LEVEL INTRO
 246  0000              GAMEOVER_ATLAS_SRC_PAGE EQU #50  ; source RAM page для GAME OVER atlas
 247  0000              LVLINTRO_ATLAS_SRC_PAGE EQU #51  ; source RAM page для LEVEL INTRO atlas
 248  0000              TEXT_NUM_SPRITES      EQU 5
 249  0000              TEXT_SPRITE_W         EQU 64
 250  0000              TEXT_SPRITE_H         EQU 64
 251  0000              TEXT_W                EQU TEXT_NUM_SPRITES * TEXT_SPRITE_W   ; 320
 252  0000              TEXT_X                EQU (CANVAS_W - TEXT_W) / 2             ; 20
 253  0000              TEXT_Y                EQU (CANVAS_H - TEXT_SPRITE_H) / 2      ; 112
 254  0000              TEXT_SPAL             EQU 5
 255  0000
 256  0000              ; SPIRAL OF DOOM subtitle — 5 sprites 64×32 при scattered TNUMs в page #0D
 257  0000              ; (cx=40..63, cy=0..7). Рендерим под LEVEL 1-1, screen Y = TEXT_Y + 64 + 8.
 258  0000              SUBTITLE_SPRITE_H     EQU 32
 259  0000              SUBTITLE_Y            EQU TEXT_Y + TEXT_SPRITE_H + 8          ; 184
 260  0000              ; Pre-computed TNUMs для каждого SP0..SP4: 3584 + cy*64 + cx.
 261  0000              SUBTITLE_TNUM_0       EQU 3584 + 0*64 + 40   ; 3624
 262  0000              SUBTITLE_TNUM_1       EQU 3584 + 0*64 + 48   ; 3632
 263  0000              SUBTITLE_TNUM_2       EQU 3584 + 0*64 + 56   ; 3640
 264  0000              SUBTITLE_TNUM_3       EQU 3584 + 4*64 + 40   ; 3880
 265  0000              SUBTITLE_TNUM_4       EQU 3584 + 4*64 + 48   ; 3888
 266  0000              KZ_PIX             EQU 64
 267  0000              ROTATION_SPEED EQU 4
 268  0000
 269  0000              ; ================================================================
 270  0000              ; СТРУКТУРА ШАРА (8 байт) — летящий после выстрела
 271  0000              ; ================================================================
 272  0000              BALL_X      EQU 0
 273  0000              BALL_Y      EQU 2
 274  0000              BALL_ANGLE  EQU 4
 275  0000              BALL_SPEED  EQU 5
 276  0000              BALL_ACTIVE EQU 6
 277  0000              BALL_COLOR  EQU 7
 278  0000
 279  0000              ; ================================================================
 280  0000              ; ЦЕПОЧКА — VDC МОДЕЛЬ (Virtual Discrete Chain). См. полное описание выше.
 281  0000              ; Slots[k] = цвет либо GAP-маркер (>= NUM_BALL_COLORS).
 282  0000              ; t_i = (Chain0_HeadSlotAbs - i) * CELL_SIZE + Chain0_HeadSub + SlotOffsets[i]
 283  0000              ; SlotsLen — количество активных slots (head=0, tail=SlotsLen-1).
 284  0000              ; Insert: shift_right(Slots, idx) + Slots[idx]=color + SlotsLen += 1 + HSA += 1.
 285  0000              ; Spawn: Slots[SlotsLen] = color, SlotsLen += 1 (новый шар на хвостовой стороне).
 286  0000              ; Match-3: window-3 scan ставит GAP_STOP в lb..rb, GapStep сдвигает GAP'ы к концу
 287  0000              ; массива, при close SlotsLen уменьшается на 1.
 288  0000              ; ================================================================
 289  0000
 290  0000              ; ================================================================
 291  0000              ; ПЕРЕМЕННЫЕ DMA/CHAIN-PREV — выделенная зона #4000-#5FFF в slot 1 page 5.
 292  0000              ; До main0.bin (#6000-#7FFF). Большие массивы здесь не straddle slot 1/2
 293  0000              ; boundary при #8000 — shift кода в #6000+ их не двигает. Все DS = uninitialized
 294  0000              ; на boot; InitGame явно зануляет ChainPrevValid[A/B], остальные пишутся per-frame.
 295  0000              ; Освобождает slot 2 part от data-pressure → код может расти без layout corruption.
 296  0000              ; ================================================================
 297  0000                  SLOT 1
 297  0000                PAGE 5
 298  0000                  ORG #4000
 299  4000
 300  4000 00           BcsDstLow:    DB 0
 301  4001 00           BcsDstMid:    DB 0
 302  4002 00           BcsPageOver:  DB 0
 303  4003 00           BcsPrevLow:   DB 0
 304  4004 00           BcsPrevMid:   DB 0
 305  4005 00           BcsPrevPage:  DB 0
 306  4006 00           BcsGoldenOff: DB 0
 307  4007 00           BcsClipTop:   DB 0
 308  4008 00           BcsClipBot:   DB 0
