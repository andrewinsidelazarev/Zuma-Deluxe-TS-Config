5628  8AE0              ; Трек уровня. Spgbld page 2 ограничена 16K (0x8000-0xBFFF).
5629  8AE0              ; Делим level_01.bin на 2 части: [0..N1] в slot 2 page 2, [N1..end] в slot 3 page #0C.
5630  8AE0              ; ВАЖНО: ComputeSlotXY и killzone-init читают через virtual address 0x969C+ который
5631  8AE0              ; пересекает 0xC000 boundary — runtime PAGE3=#0C maps slot 3 к нужным байтам.
5632  8AE0              ; ORG #969C принудительно — иначе sjasmplus emit может сдвинуться при изменениях в коде
5633  8AE0              ; и track[3095] не попадёт точно на 0xC6F8 (killzone) в overflow page.
5634  8AE0                  ORG #969C
5635  969C              TrackData:
5636  969C                  INCBIN "level_01.bin", 0, 10596    ; first 10596 bytes → 0x969C..0xBFFF (slot 2 page 2)
5637  C000              TRACK_DATA_P1_END:
5638  C000
5639  C000                  SLOT 3
5639  C000                PAGE #0C
5639  C000                ORG #C000      ; явно switch к slot 3 page #60 для overflow
5640  C000              TrackOverflow:
5641  C000                  INCBIN "level_01.bin", 10596       ; remaining 1790 bytes → 0xC000..0xC6FD
5642  C456              TrackEnd:
5643  C456              TRACK_NUM_POINTS EQU (TrackEnd - TrackOverflow + 10596 - 2) / 4  ; = 3096
5644  C456
5645  C456                  SLOT 2
5645  C456                PAGE 2                    ; вернуться в page 2 для следующих ORG'ов
