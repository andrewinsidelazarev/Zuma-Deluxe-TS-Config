3849  749C              ; ================================================================
3850  749C              ; CANVAS A=#10..#18, B=#20..#28. Golden=#30..#38. Учебная схема:
3851  749C              ; full copy golden→shadow + blit chain + atomic VPAGE swap в начале vblank.
3852  749C              ; ================================================================
3853  749C              CANVAS_B_PAGE_BASE EQU #20
3854  749C              GOLDEN_PAGE_BASE   EQU #30
3855  749C
3856  749C              ; ================================================================
3857  749C              ; COPY GOLDEN TO SHADOW — DMA 9 страниц фона в текущий shadow buffer.
3858  749C              ; ShadowPageBase обновляется при swap.
3859  749C              ; ================================================================
3860  749C              ; ================================================================
3861  749C              ; UPDATE KZ FRAME — каждый тик: вычислить target frame по дистанции head→kz,
3862  749C              ; продвинуть KzFrame к target, при изменении KzFrame перевыпечь kz в golden
3863  749C              ; (чтобы chain DMA restore читал АКТУАЛЬНЫЙ frame, без stale frame под шарами).
3864  749C              ; State 1/2 → target = full open (= NUM_FRAMES-1).
3865  749C              ; State 0: distance = (TRACK-1) - head_t. Если dist >= KZ_OPEN_DIST → closed (0).
3866  749C              ; Иначе frame = (KZ_OPEN_DIST - dist) / 8 (capped к NUM_FRAMES-1).
3867  749C              ; Roll-back (head_t уменьшается → dist растёт) → target снижается → mouth закрывается.
3868  749C              ; ================================================================
3869  749C              UpdateKzFrame:
3870  749C 3A 15 40         LD A, (GameState)
3871  749F B7               OR A
3872  74A0 28 04            JR Z, .ukf_state0
3873  74A2 3E 09            LD A, KZ_NUM_FRAMES - 1
3874  74A4 18 50            JR .ukf_target_set
3875  74A6
3876  74A6              .ukf_state0:
3877  74A6                  ; head_t = HSA*32 + hsub + offset[0] (signed)
3878  74A6 3A 9C 85         LD A, (Chain0_HeadSlotAbs)
3879  74A9 26 00            LD H, 0
3879  74AB 6F             LD L, A
3880  74AC 29               ADD HL, HL
3880  74AD 29             ADD HL, HL
3880  74AE 29             ADD HL, HL
3881  74AF 29               ADD HL, HL
3881  74B0 29             ADD HL, HL                  ; HL = HSA*32
3882  74B1 3A 9D 85         LD A, (Chain0_HeadSub)
3883  74B4 5F               LD E, A
3883  74B5 16 00          LD D, 0
3884  74B7 19               ADD HL, DE                               ; +hsub
3885  74B8 3A DC 81         LD A, (Chain0_SlotOffsets)
3886  74BB 5F               LD E, A
3886  74BC 16 00          LD D, 0
3887  74BE CB 7F            BIT 7, A
3888  74C0 28 01            JR Z, .ukf_off_pos
3889  74C2 15               DEC D                                    ; sign-extend negative offset
3890  74C3              .ukf_off_pos:
3891  74C3 19               ADD HL, DE                               ; HL = head_t (signed)
3892  74C4 CB 7C            BIT 7, H
3893  74C6 28 03            JR Z, .ukf_have_t
3894  74C8 21 00 00         LD HL, 0                                 ; t<0 → use 0
3895  74CB              .ukf_have_t:
3896  74CB 11 6D 0B         LD DE, TRACK_NUM_POINTS - 1
3897  74CE EB               EX DE, HL
3898  74CF A7               AND A
3899  74D0 ED 52            SBC HL, DE                               ; HL = (TRACK-1) - head_t = distance
3900  74D2 CB 7C            BIT 7, H
3901  74D4 20 1B            JR NZ, .ukf_full_open                    ; dist < 0 → past kz → full open
3902  74D6 7C               LD A, H
3903  74D7 B7               OR A
3904  74D8 20 1B            JR NZ, .ukf_closed                        ; dist >= 256 → closed
3905  74DA 7D               LD A, L
3906  74DB FE 60            CP KZ_OPEN_DIST
3907  74DD 30 16            JR NC, .ukf_closed                        ; dist >= 96 → closed
3908  74DF                  ; A = dist 0..95. frame = (96 - dist) / 8 (capped 0..9)
3909  74DF 47               LD B, A
3910  74E0 3E 60            LD A, KZ_OPEN_DIST
3911  74E2 90               SUB B                                    ; A = 96 - dist (1..96)
3912  74E3 CB 3F            SRL A
3912  74E5 CB 3F          SRL A
3912  74E7 CB 3F          SRL A                    ; / 8 (0..12)
3913  74E9 FE 0A            CP KZ_NUM_FRAMES
3914  74EB 38 09            JR C, .ukf_target_set
3915  74ED 3E 09            LD A, KZ_NUM_FRAMES - 1
3916  74EF 18 05            JR .ukf_target_set
3917  74F1
3918  74F1              .ukf_full_open:
3919  74F1 3E 09            LD A, KZ_NUM_FRAMES - 1
3920  74F3 18 01            JR .ukf_target_set
3921  74F5
3922  74F5              .ukf_closed:
3923  74F5 AF               XOR A
3924  74F6
3925  74F6              .ukf_target_set:
3926  74F6 32 52 80         LD (KzTargetFrame), A
3927  74F9
3928  74F9                  ; Animation: каждые KZ_FRAME_DELAY тиков двигаем KzFrame к KzTargetFrame на 1.
3929  74F9 3A 51 80         LD A, (KzFrameWait)
3930  74FC 3C               INC A
3931  74FD FE 04            CP KZ_FRAME_DELAY
3932  74FF 38 1A            JR C, .ukf_save_wait
3933  7501 AF               XOR A
3934  7502 32 51 80         LD (KzFrameWait), A
3935  7505 3A 50 80         LD A, (KzFrame)
3936  7508 47               LD B, A
3937  7509 3A 52 80         LD A, (KzTargetFrame)
3938  750C B8               CP B
3939  750D 28 0F            JR Z, .ukf_check_burn                    ; same — нечего двигать
3940  750F 38 03            JR C, .ukf_dec
3941  7511 04               INC B
3942  7512 18 01            JR .ukf_save_frame
3943  7514              .ukf_dec:
3944  7514 05               DEC B
3945  7515              .ukf_save_frame:
3946  7515 78               LD A, B
