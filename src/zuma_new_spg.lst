3538  72A2              ; ================================================================
3539  72A2              ; MOVE CHAIN — попиксельное движение через HeadSub (0..CELL_SIZE-1).
3540  72A2              ; HeadSub++ каждый вызов; overflow → HeadSub=0, HeadSlotAbs++.
3541  72A2              ; Cascade reverse: HeadSub--, underflow → HeadSub=CELL_SIZE-1, HeadSlotAbs--.
3542  72A2              ; ChainStalled — стоп.
3543  72A2              ; ================================================================
3544  72A2              TRACK_NUM_SLOTS       EQU TRACK_NUM_POINTS / CELL_SIZE  ; 96
3545  72A2
3546  72A2              MoveChain:
3547  72A2                  ; Cascade state — цепочка стоит (instant HSA -= count в .cpt_cascade уже сделан).
3548  72A2                  ; Reverse-anim не нужен.
3549  72A2 3A 46 80         LD A, (CascadeState)
3550  72A5 B7               OR A
3551  72A6 C0               RET NZ
3552  72A7              .mc_normal_check:
3553  72A7 3A 75 80         LD A, (ChainStalled)
3554  72AA B7               OR A
3555  72AB C0               RET NZ
3556  72AC
3557  72AC                  ; ChainFreezeCounter > 0 → пауза hsub-инкремента (head компенсация декаит без
3558  72AC                  ; параллельного chain motion, иначе net advance = 2 cell вместо 1).
3559  72AC 3A 4D 80         LD A, (ChainFreezeCounter)
3560  72AF B7               OR A
3561  72B0 28 05            JR Z, .mc_no_freeze
3562  72B2 3D               DEC A
3563  72B3 32 4D 80         LD (ChainFreezeCounter), A
3564  72B6 C9               RET
3565  72B7              .mc_no_freeze:
3566  72B7
3567  72B7 3A 9D 85         LD A, (Chain0_HeadSub)
3568  72BA 3C               INC A
3569  72BB FE 20            CP CELL_SIZE
3570  72BD 38 12            JR C, .mc_save_sub
3571  72BF                  ; Sub wraps to 0. Обычно HSA++. Если HSA уже на cap (TRACK_NUM_SLOTS-1) —
3572  72BF                  ; head шар «вылетает» в killzone: shift_left arrays + SlotsLen--. Иначе chain
3573  72BF                  ; залипает на конце track когда длина почти max — head не может advance.
3574  72BF AF               XOR A
3575  72C0 32 9D 85         LD (Chain0_HeadSub), A
3576  72C3 3A 9C 85         LD A, (Chain0_HeadSlotAbs)
3577  72C6 3C               INC A
3578  72C7 FE 5B            CP TRACK_NUM_SLOTS
3579  72C9 38 02            JR C, .mc_save_slot
3580  72CB 3E 5A            LD A, TRACK_NUM_SLOTS - 1
3581  72CD              .mc_save_slot:
3582  72CD 32 9C 85         LD (Chain0_HeadSlotAbs), A
3583  72D0 C9               RET
3584  72D1              .mc_save_sub:
3585  72D1 32 9D 85         LD (Chain0_HeadSub), A
3586  72D4 C9               RET
3587  72D5
3588  72D5              ; ================================================================
3589  72D5              ; MOVE CHAIN ABSORB — вариант MoveChain'а для Game-Over state 1.
3590  72D5              ; При HSA on cap И hsub wraps → НЕ clamp HSA, а CALL AbsorbHead — head шар
3591  72D5              ; «вылетает» в killzone, цепь укорачивается на 1, остальные шары сдвигаются
3592  72D5              ; так что их track-позиции непрерывны (HSA НЕ декрементируем — shift сам
3593  72D5              ; компенсирует, см. ниже). Используется в UpdateGame.ug_state1.
3594  72D5              ; ================================================================
3595  72D5              MoveChainAbsorb:
3596  72D5 3A 46 80         LD A, (CascadeState)
3596  72D8 B7             OR A
3596  72D9 C0             RET NZ
3597  72DA 3A 75 80         LD A, (ChainStalled)
3597  72DD B7             OR A
3597  72DE C0             RET NZ
3598  72DF 3A 4D 80         LD A, (ChainFreezeCounter)
3599  72E2 B7               OR A
3600  72E3 28 05            JR Z, .mca_no_freeze
3601  72E5 3D               DEC A
3601  72E6 32 4D 80       LD (ChainFreezeCounter), A
3602  72E9 C9               RET
3603  72EA              .mca_no_freeze:
3604  72EA 3A 9D 85         LD A, (Chain0_HeadSub)
3605  72ED 3C               INC A
3606  72EE FE 20            CP CELL_SIZE
3607  72F0 38 19            JR C, .mca_save_sub
3608  72F2 AF               XOR A
3609  72F3 32 9D 85         LD (Chain0_HeadSub), A
3610  72F6 3A 9C 85         LD A, (Chain0_HeadSlotAbs)
3611  72F9 3C               INC A
3612  72FA FE 5B            CP TRACK_NUM_SLOTS
3613  72FC 38 09            JR C, .mca_save_slot
3614  72FE                  ; HSA at cap. HSA остаётся на cap (= TRACK_NUM_SLOTS-1), но head ball
3615  72FE                  ; consumed: shift_left arrays + SlotsLen-=1. Continuity: old slot_t(1)
3616  72FE                  ; at hsub=32 = (cap-1)*32+32+offsets[1] = cap*32+offsets[1]. После shift
3617  72FE                  ; new slot_t(0) = cap*32+0+(old offsets[1]) = тот же. ✓ no jerk.
3618  72FE 3E 5A            LD A, TRACK_NUM_SLOTS - 1
3619  7300 32 9C 85         LD (Chain0_HeadSlotAbs), A
3620  7303 CD 0F 73         CALL AbsorbHead
3621  7306 C9               RET
3622  7307              .mca_save_slot:
3623  7307 32 9C 85         LD (Chain0_HeadSlotAbs), A
3624  730A C9               RET
3625  730B              .mca_save_sub:
3626  730B 32 9D 85         LD (Chain0_HeadSub), A
3627  730E C9               RET
