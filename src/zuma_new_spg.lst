3059  701E              ; ================================================================
3060  701E              ; DO GAP STEP — один шаг movement всех GAP-cells.
3061  701E              ; STOP-cells: pass right→left (чтобы swap не двигал тот же cell дважды),
3062  701E              ;             swap Slots[k] = STOP с Slots[k+1] = (color/non-STOP).
3063  701E              ;             Если k+1 == SlotsLen → SlotsLen -= 1 (exit с tail-end).
3064  701E              ; CASCADE-cells: pass left→right, swap Slots[k] = CASCADE с Slots[k-1].
3065  701E              ;             Если k == 0 → shift_left + HSA -= 1 + SlotsLen -= 1.
3066  701E              ; ================================================================
3067  701E              DoGapStep:
3068  701E                  ; --- Pass 1: STOP closure — last GAP_STOP from tail-side (хвост подъезжает к голове) ---
3069  701E 3A 9E 85         LD A, (Chain0_SlotsLen)
3070  7021 B7               OR A
3071  7022 CA 1B 71         JP Z, .dgs_cascade_init
