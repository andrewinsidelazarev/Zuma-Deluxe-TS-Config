 524  610E B7               OR A
 525  610F 20 36            JR NZ, .ug_kz_anim                ; chain не пуст — продолжаем в state 1
 526  6111 3E 02            LD A, 2
 527  6113 32 15 40         LD (GameState), A
 528  6116 AF               XOR A
 529  6117 32 17 40         LD (GameOverTick), A
 530  611A CD 08 80         CALL LoadGameOverPalette          ; swap red ball palette → custom yellow+red gradient
 531  611D                  ; DMA-копируем GAME OVER atlas (page #50) → #0D, перезаписывая LEVEL INTRO.
 532  611D 3E 50            LD A, GAMEOVER_ATLAS_SRC_PAGE
 533  611F CD F4 75         CALL CopyAtlasToPageD
