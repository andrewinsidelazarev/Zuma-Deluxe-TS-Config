4066  75C8
4067  75C8 DD 7E 00         LD A, (IX+0)
4068  75CB 77               LD (HL), A
4068  75CC 23             INC HL                                  ; TNUM_L from table
4069  75CD DD 7E 01         LD A, (IX+1)
4070  75D0 E6 0F            AND #0F
4071  75D2 F6 50            OR TEXT_SPAL << 4
4072  75D4 77               LD (HL), A
4072  75D5 23             INC HL                                  ; TNUM_H | SPAL<<4
4073  75D6
4074  75D6 DD 23            INC IX
4074  75D8 DD 23          INC IX
