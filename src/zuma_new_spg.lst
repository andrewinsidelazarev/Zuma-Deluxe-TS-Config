3948  7519 18 03            JR .ukf_check_burn
3949  751B              .ukf_save_wait:
3950  751B 32 51 80         LD (KzFrameWait), A
3951  751E
3952  751E              .ukf_check_burn:
3953  751E                  ; Re-burn НЕ нужен — sun (DMA) static, не меняется. Skull (TSU) меняется через
3954  751E                  ; descriptor TNUM, golden остаётся с sun-only burn'ом.
3955  751E C9               RET
