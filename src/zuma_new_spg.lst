4146  7697              ; ================================================================
4147  7697              ; BLIT CHAIN TO SHADOW — три прохода:
4148  7697              ;   PRE:   BcsPreClassify заполняет SkipFlag[i] и кэш геометрии для DRAW.
4149  7697              ;   PASS1: restore prev positions, НО только если SkipFlag != PRESERVE.
4150  7697              ;          Это сохраняет хвост в shadow при cascade roll-back (HSA-i<0 / t<0).
4151  7697              ;   PASS2: для DRAW — blit из кэша + сохранить новый prev. DESTROY — invalidate.
4152  7697              ;          PRESERVE — не трогать prev/shadow.
4153  7697              ; Двух-pass нужен чтобы не "выгрызать" outline соседним restore'ом.
4154  7697              ; ================================================================
4155  7697              BlitChainToShadow:
4156  7697                  ; --- Выбор golden offset по текущему shadow buffer ---
4157  7697                  ; BcsGoldenOff читается KzRestoreHalf в BlitKillzoneToShadow → setup обязателен
4158  7697                  ; даже когда chain DMA отключён (chain рисуется TSU).
4159  7697 3A 14 40         LD A, (ShadowPageBase)
4160  769A FE 10            CP CANVAS_A_PAGE_BASE
4161  769C 20 07            JR NZ, .bcs_use_b
4162  769E 3E 20            LD A, #20
4162  76A0 32 06 40       LD (BcsGoldenOff), A           ; canvas A → golden = +#20
4163  76A3 18 05            JR .bcs_have
4164  76A5              .bcs_use_b:
4165  76A5 3E 10            LD A, #10
4165  76A7 32 06 40       LD (BcsGoldenOff), A           ; canvas B → golden = +#10
4166  76AA              .bcs_have:
4167  76AA
4168  76AA                  ; Chain рендерится DMA (= partial-clip для entry-zone trackpoints с y<0,
4169  76AA                  ; шары вылезают из-за верхнего края канваса). UpdateChainTSUSprites больше не
4170  76AA                  ; вызывается — TSU chain слоты держатся off-screen через HideChainSprites.
4171  76AA 01 AF 15         LD BC, FMADDR
4171  76AD AF             XOR A
4171  76AE ED 79          OUT (C), A        ; FM_EN=0 для DMA
4172  76B0 3E 09            LD A, DMA_BURST_WORDS-1
4172  76B2 01 AF 26       LD BC, DMALEN
4172  76B5 ED 79          OUT (C), A   ; 9 words burst
4173  76B7                  ; DMANUM ставится индивидуально каждым blit/restore (partial-blit: переменное число строк)
4174  76B7
4175  76B7                  ; --- PRE-PASS: классификация slot'ов и кэш геометрии для DRAW ---
4176  76B7 CD 3D 78         CALL BcsPreClassify
4177  76BA
4178  76BA                  ; ===================== PASS 1: restore prev (только !PRESERVE) =====================
4179  76BA 3A 14 40         LD A, (ShadowPageBase)
4180  76BD FE 10            CP CANVAS_A_PAGE_BASE
4181  76BF 20 0A            JR NZ, .p1_use_b
4182  76C1 DD 21 1E 40      LD IX, ChainPrevDstA
4183  76C5 FD 21 DE 43      LD IY, ChainPrevValidA
4184  76C9 18 08            JR .p1_start
4185  76CB              .p1_use_b:
4186  76CB DD 21 CE 44      LD IX, ChainPrevDstB
4187  76CF FD 21 8E 48      LD IY, ChainPrevValidB
4188  76D3              .p1_start:
4189  76D3 21 7E 49         LD HL, BcsSkipFlag
4190  76D6 06 F0            LD B, MAX_CHAIN_BALLS
4191  76D8              .p1_loop:
4192  76D8 C5               PUSH BC
4193  76D9 E5               PUSH HL
4194  76DA FD 7E 00         LD A, (IY+0)
4195  76DD B7               OR A
4196  76DE 28 50            JR Z, .p1_skip                            ; PrevValid=0 — нечего restore
4197  76E0 7E               LD A, (HL)
4198  76E1 FE 02            CP BCS_PRESERVE
4199  76E3 28 4B            JR Z, .p1_skip                            ; PRESERVE — оставляем шар в shadow
4200  76E5
4201  76E5                  ; restore: golden и shadow на одной X/Y зоне → src/dst low/mid одинаковы,
4202  76E5                  ; различаются только page (golden = shadow + BcsGoldenOff).
4203  76E5 DD 7E 00         LD A, (IX+0)
4203  76E8 01 AF 1A       LD BC, DMASADL
4203  76EB ED 79          OUT (C), A
4204  76ED DD 7E 01         LD A, (IX+1)
4204  76F0 01 AF 1B       LD BC, DMASADH
4204  76F3 ED 79          OUT (C), A
4205  76F5 DD 7E 02         LD A, (IX+2)
4206  76F8 47               LD B, A
4207  76F9 3A 06 40         LD A, (BcsGoldenOff)
4208  76FC 80               ADD A, B
4209  76FD 01 AF 1C         LD BC, DMASADX
4209  7700 ED 79          OUT (C), A
4210  7702 DD 7E 00         LD A, (IX+0)
4210  7705 01 AF 1D       LD BC, DMADADL
4210  7708 ED 79          OUT (C), A
4211  770A DD 7E 01         LD A, (IX+1)
4211  770D 01 AF 1E       LD BC, DMADADH
4211  7710 ED 79          OUT (C), A
4212  7712 DD 7E 02         LD A, (IX+2)
4212  7715 01 AF 1F       LD BC, DMADADX
4212  7718 ED 79          OUT (C), A
4213  771A DD 7E 03         LD A, (IX+3)
4213  771D 3D             DEC A
4213  771E 01 AF 28       LD BC, DMANUM
4213  7721 ED 79          OUT (C), A   ; num_lines-1 (под partial-blit)
4214  7723 3E B9            LD A, DMA_BLT_8BPP_MODE
4214  7725 01 AF 27       LD BC, DMACTR
4214  7728 ED 79          OUT (C), A
