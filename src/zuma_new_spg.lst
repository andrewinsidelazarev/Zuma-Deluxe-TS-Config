3669  7356              ; ================================================================
3670  7356              ; CHECK HEAD AT KILLZONE — Manhattan(head_pos, KzCenter) < 16 ?
3671  7356              ; Out: A = 1 если да (= триггер Game Over), A = 0 иначе.
3672  7356              ; Использует ComputeSlotXY(0) → TmpHemX/TmpHemY, затем подставляет
3673  7356              ; KzCenter в TmpBallCX/TmpBallCY и вызывает ManhattanDistToBall.
3674  7356              ; Clobbers A,BC,DE,HL,TmpHemX/Y,TmpBallCX/Y,TmpHemSlotIdx.
3675  7356              ; ================================================================
3676  7356              CheckHeadAtKillzone:
3677  7356 3A 9E 85         LD A, (Chain0_SlotsLen)
3678  7359 B7               OR A
3679  735A 28 1F            JR Z, .chk_no                    ; пустая цепь — не trigger
3680  735C AF               XOR A                            ; head idx = 0
3681  735D CD F6 6C         CALL ComputeSlotXY               ; → TmpHemX, TmpHemY
3682  7360 2A 54 80         LD HL, (KzCenterX)
3683  7363 22 77 80         LD (TmpBallCX), HL
3684  7366 2A 56 80         LD HL, (KzCenterY)
3685  7369 22 79 80         LD (TmpBallCY), HL
3686  736C CD 52 6D         CALL ManhattanDistToBall         ; HL = Manhattan
3687  736F 7C               LD A, H
3688  7370 B7               OR A
3689  7371 20 08            JR NZ, .chk_no                   ; HL >= 256 — точно >= 16
3690  7373 7D               LD A, L
3691  7374 FE 10            CP 16
3692  7376 30 03            JR NC, .chk_no
3693  7378 3E 01            LD A, 1
3694  737A C9               RET
3695  737B              .chk_no:
3696  737B AF               XOR A
3697  737C C9               RET
