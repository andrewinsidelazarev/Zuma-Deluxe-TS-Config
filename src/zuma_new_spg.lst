3406  7214              ; ================================================================
3407  7214              ; SCAN FOR NEW MATCH — full-chain window-3 scan. При найденном run >= 3
3408  7214              ; устанавливает TmpMatch* и вызывает CheckMatch3 без detect (= просто apply).
3409  7214              ; Используется AnimateChain после GAP-step — обнаружение новых match'ей
3410  7214              ; которые сложились из-за движения GAP'ов или новых spawn'ов.
3411  7214              ; ================================================================
3412  7214              ScanForNewMatch:
3413  7214                  ; Persistent Shot2-scan (запускается каждый кадр из AnimateChain). Не gated на
3414  7214                  ; MatchScanIdx — проверяет Shot2 каждый раз. Shot2 НЕ очищается на failed match —
3415  7214                  ; offset gap check в DetectMatch3 может временно блокировать match (offsets=-32
3416  7214                  ; после shift), а через ~25-32 кадров offsets decay'ят и match сработает естественно.
3417  7214                  ; Shot2 очищается ТОЛЬКО при:
3418  7214                  ;  - successful match (= consumed),
3419  7214                  ;  - slot стал GAP'ом (cleanup stale),
3420  7214                  ;  - offsets полностью settled (=0) у k и соседей (= retry done, no cascade).
3421  7214 3A 9E 85         LD A, (Chain0_SlotsLen)
3422  7217 B7               OR A
3423  7218 C8               RET Z
3424  7219 47               LD B, A                                   ; B = SlotsLen iter counter
3425  721A 21 CC 82         LD HL, Chain0_Shot2
3426  721D 0E 00            LD C, 0
3427  721F              .snm_shot2_loop:
3428  721F 7E               LD A, (HL)
3429  7220 B7               OR A
3430  7221 CA 80 72         JP Z, .snm_shot2_next
3431  7224
3432  7224                  ; --- Cleanup: Slots[C] is GAP → clear Shot2 (stale)  ---
3433  7224 C5               PUSH BC
3434  7225 E5               PUSH HL
3435  7226 79               LD A, C
3436  7227 26 00            LD H, 0
3436  7229 6F             LD L, A
3437  722A 11 EC 80         LD DE, Chain0_Slots
3438  722D 19               ADD HL, DE
3439  722E 7E               LD A, (HL)
3440  722F E1               POP HL
3441  7230 C1               POP BC
3442  7231 FE 06            CP NUM_BALL_COLORS
3443  7233 38 05            JR C, .snm_check_match
3444  7235 36 00            LD (HL), 0                                ; GAP slot → clear Shot2
3445  7237 C3 80 72         JP .snm_shot2_next
3446  723A
3447  723A              .snm_check_match:
3448  723A C5               PUSH BC
3449  723B E5               PUSH HL
