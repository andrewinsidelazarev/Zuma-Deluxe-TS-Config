3464  7250 19               ADD HL, DE
3465  7251 7E               LD A, (HL)
3466  7252 B7               OR A
3467  7253 20 29            JR NZ, .snm_unsettled                     ; offset[C] != 0
3468  7255                  ; Check left neighbor
3469  7255 79               LD A, C
3470  7256 B7               OR A
3471  7257 28 0C            JR Z, .snm_check_right
3472  7259 3D               DEC A
3473  725A 26 00            LD H, 0
3473  725C 6F             LD L, A
3474  725D 11 DC 81         LD DE, Chain0_SlotOffsets
3475  7260 19               ADD HL, DE
3476  7261 7E               LD A, (HL)
3477  7262 B7               OR A
3478  7263 20 19            JR NZ, .snm_unsettled
