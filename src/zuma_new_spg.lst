4421  78B0 11 9C 96         LD DE, TrackData
4422  78B3 19               ADD HL, DE
4423  78B4 7E               LD A, (HL)
4423  78B5 D6 0A          SUB DMA_SPRITE_HALF
4423  78B7 32 6B 80       LD (TmpChainX), A
4423  78BA 23             INC HL
4424  78BB 7E               LD A, (HL)
4424  78BC DE 00          SBC A, 0
4424  78BE 32 6C 80       LD (TmpChainX+1), A
4424  78C1 23             INC HL
4425  78C2 7E               LD A, (HL)
4425  78C3 D6 0A          SUB DMA_SPRITE_HALF
4425  78C5 32 6D 80       LD (TmpChainY), A
4425  78C8 23             INC HL
4426  78C9 7E               LD A, (HL)
4426  78CA DE 00          SBC A, 0
4426  78CC 32 6E 80       LD (TmpChainY+1), A
