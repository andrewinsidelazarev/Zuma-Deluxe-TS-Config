 139  0000              ; tiltspiral 5:4 (без letterbox) — smart crop tx[26..613], ty[0..470]
 140  0000              ; gx=242 gy=248 → screen (132, 152) → top-left (100, 120)
 141  0000              FROG_INIT_X EQU 152        ; top-left frog 64×64 → center (184, 140) = spiral center (level 1)
 142  0000              FROG_INIT_Y EQU 108
 143  0000
 144  0000              MOUSE_INIT_X EQU FROG_INIT_X + 72                ; 220 — справа от жабы → стартовый угол ~0
 145  0000              MOUSE_INIT_Y EQU FROG_INIT_Y + 32                ; 144 — центр жабы по Y (SPR_SIZE/2)
 146  0000
 147  0000              ; Cursor 16x16 in 360x288 screen — top-left limits
 148  0000              CURSOR_MIN_X EQU 0
 149  0000              CURSOR_MIN_Y EQU 0
 150  0000              CURSOR_MAX_X EQU SCR_W - 16                     ; 344
 151  0000              CURSOR_MAX_Y EQU SCR_H - 16                     ; 272
