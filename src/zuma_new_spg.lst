 322  4015              ; --- Game-Over state machine (init в InitGame явно — DEFS не SAVEBIN'ятся) ---
 323  4015              ; 0 = playing (normal). 1 = absorbing (head пожирается killzone'ом, FAST_ADVANCE×
 324  4015              ; MoveChainAbsorb, при HSA cap shift slots + slots_len-=1). 2 = SlotsLen=0,
 325  4015              ; freeze (текст GAME OVER — TODO; пока просто стоп).
 326  4015 00           GameState:       DB 0
 327  4016 00           AbsorbCounter:   DB 0   ; сколько шаров поглощено в state 1 (для статистики/render)
 328  4017 00           GameOverTick:    DB 0   ; счётчик кадров в state 2
 329  4018 00           HeadFlightTick:  DB 0   ; 0..FLIGHT_FRAMES — счётчик «полёта» головы к центру kz в state 1
 330  4019 00 00        TmpGoX:          DW 0   ; current X в DrawTextOverlay loop
 331  401B 00           TmpGoTNumOffs:   DB 0   ; current TNUM_L offset (sprite N * 8)
 332  401C 00 00        TmpGoTNumBase:   DW 0   ; TNUM base (= GAMEOVER_TNUM_BASE или LVLINTRO_TNUM_BASE)
 333  401E
 334  401E 00 00 00...  ChainPrevDstA:    DS MAX_CHAIN_BALLS * 4
 335  43DE 00 00 00...  ChainPrevValidA:  DS MAX_CHAIN_BALLS
 336  44CE 00 00 00...  ChainPrevDstB:    DS MAX_CHAIN_BALLS * 4
 337  488E 00 00 00...  ChainPrevValidB:  DS MAX_CHAIN_BALLS
 338  497E
 339  497E 00 00 00...  BcsSkipFlag:      DS MAX_CHAIN_BALLS
 340  4A6E 00 00 00...  BcsCacheStruct:   DS MAX_CHAIN_BALLS * 6
