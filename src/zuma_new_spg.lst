4341  783D              ; ================================================================
4342  783D              ; BcsPreClassify — для каждого slot 0..MAX_CHAIN_BALLS-1:
4343  783D              ;   - i >= SlotsLen      → DESTROY
4344  783D              ;   - Slots[i] is GAP    → DESTROY
4345  783D              ;   - HSA-i < 0          → PRESERVE  (cascade roll-back, шар "за стартом")
4346  783D              ;   - t < 0              → PRESERVE  (HeadSub overflow)
4347  783D              ;   - off-canvas (X/Y)   → PRESERVE  (визуально невидимо, но ball ещё logical)
4348  783D              ;   - иначе              → DRAW + кэш геометрии в BcsCacheStruct[i*6..i*6+5]
4349  783D              ; ================================================================
4350  783D              BcsPreClassify:
4351  783D AF               XOR A
4351  783E 32 70 80       LD (TmpChainIdx), A
4352  7841 06 F0            LD B, MAX_CHAIN_BALLS
4353  7843              .bpc_loop:
4354  7843 C5               PUSH BC
4355  7844
4356  7844                  ; --- Test 1: i >= SlotsLen ---
4357  7844 3A 70 80         LD A, (TmpChainIdx)
4358  7847 21 9E 85         LD HL, Chain0_SlotsLen
4359  784A BE               CP (HL)
4360  784B D2 9E 79         JP NC, .bpc_destroy
4361  784E
4362  784E                  ; --- Test 2: Slots[i] is GAP color ---
4363  784E 3A 70 80         LD A, (TmpChainIdx)
4364  7851 26 00            LD H, 0
4364  7853 6F             LD L, A
4365  7854 11 EC 80         LD DE, Chain0_Slots
4366  7857 19               ADD HL, DE
4367  7858 7E               LD A, (HL)
4368  7859 FE 06            CP NUM_BALL_COLORS
4369  785B D2 9E 79         JP NC, .bpc_destroy                       ; >= NUM_BALL_COLORS = GAP_STOP/GAP_CASCADE/etc
4370  785E
4371  785E                  ; --- Test 2b: Exploding слот → DMA скрывается, рисуется TSU destroy через UpdateExplodeSprites ---
4372  785E 3A 70 80         LD A, (TmpChainIdx)
4373  7861 26 00            LD H, 0
4373  7863 6F             LD L, A
4374  7864 11 BC 83         LD DE, Chain0_ExplodingFrame
4375  7867 19               ADD HL, DE
4376  7868 7E               LD A, (HL)
4377  7869 B7               OR A
4378  786A C2 9E 79         JP NZ, .bpc_destroy                        ; ExplodingFrame > 0 → DMA не рисует, TSU перекрывает
4379  786D
4380  786D                  ; --- Test 3: HSA - i < 0 ---
4381  786D 3A 9C 85         LD A, (Chain0_HeadSlotAbs)
4382  7870 21 70 80         LD HL, TmpChainIdx
4383  7873 96               SUB (HL)
4384  7874 DA A3 79         JP C, .bpc_preserve
4385  7877
4386  7877 26 00            LD H, 0
4387  7879 6F               LD L, A
4388  787A 29               ADD HL, HL
4388  787B 29             ADD HL, HL
4388  787C 29             ADD HL, HL
4389  787D 29               ADD HL, HL
4389  787E 29             ADD HL, HL                    ; HL = (HSA-i)*32
4390  787F
4391  787F 3A 9D 85         LD A, (Chain0_HeadSub)
4392  7882 5F               LD E, A
4392  7883 16 00          LD D, 0
4393  7885 19               ADD HL, DE                                 ; +HeadSub
4394  7886
4395  7886 E5               PUSH HL
4396  7887 3A 70 80         LD A, (TmpChainIdx)
4397  788A 26 00            LD H, 0
4397  788C 6F             LD L, A
4398  788D 11 DC 81         LD DE, Chain0_SlotOffsets
4399  7890 19               ADD HL, DE
4400  7891 7E               LD A, (HL)
4401  7892 5F               LD E, A
4401  7893 16 00          LD D, 0
4402  7895 CB 7F            BIT 7, A
4403  7897 28 01            JR Z, .bpc_so_pos
4404  7899 15               DEC D                                      ; sign-extend negative SlotOffset
4405  789A              .bpc_so_pos:
4406  789A E1               POP HL
4407  789B 19               ADD HL, DE                                 ; HL = t (signed)
4408  789C CB 7C            BIT 7, H
4409  789E C2 A3 79         JP NZ, .bpc_preserve                       ; t < 0 → PRESERVE
4410  78A1
4411  78A1                  ; Clamp t to TRACK_NUM_POINTS-1 (чтобы хвост на конце трека не лез за границу)
4412  78A1 E5               PUSH HL
4413  78A2 11 6E 0B         LD DE, TRACK_NUM_POINTS
4414  78A5 A7               AND A
4415  78A6 ED 52            SBC HL, DE
4416  78A8 E1               POP HL
4417  78A9 38 03            JR C, .bpc_t_in
4418  78AB 21 6D 0B         LD HL, TRACK_NUM_POINTS - 1
4419  78AE              .bpc_t_in:
