5449  803A              ; ДАННЫЕ
5450  803A              ; ================================================================
5451  803A 98 00        FrogX:      DW FROG_INIT_X
5452  803C 6C 00        FrogY:      DW FROG_INIT_Y
5453  803E 00           FrogAngle:  DB 0
5454  803F 04           LevelNumColors: DB 4   ; level 1 = 4 colors (per ZumaHD levels.xml settings/level1)
5455  8040                                     ; RandomBallColor / RandomChainColor берут mod этого значения.
5456  8040 00           NextBallColor: DB 0    ; цвет следующего выстрела (RandomBallColor: LFSR × RTC сек)
5457  8041 00 00        BallColorSeed:  DW 0   ; seed LFSR для NextBallColor (init из RTC секунд)
5458  8043 00 00        ChainColorSeed: DW 0   ; seed LFSR для NextChainColor (init фикс, scramble RTC при первом вызове)
5459  8045 01           ChainColorFirst: DB 1  ; флаг "первый вызов RandomChainColor" (для RTC scramble)
5460  8046 00           CascadeState:    DB 0  ; legacy, не используется в VDC-модели (= всегда 0)
5461  8047 00           CascadeIdx:      DB 0
5462  8048 00           CascadeWait:     DB 0
5463  8049 00           CascadeDelay:    DB 0
5464  804A 00           StopModeTimer:   DB 0
5465  804B 00           CompactTimer:    DB 0
5466  804C 00           GapStepCounter:  DB 0  ; subdivider для GAP movement (1 step каждые GAP_STEP_FRAMES)
5467  804D 00           ChainFreezeCounter: DB 0 ; пауза hsub-инкремента на N кадров после insert/cascade-close
5468  804E 00           MatchScanIdx:    DB 0  ; idx где scan для new match (set после GAP closure), #FF = no scan
5469  804F 00           TmpGapIdx:       DB 0  ; рабочий регистр в DoGapStep (idx найденного GAP-cell для удаления)
5470  8050 00           KzFrame:         DB 0  ; current killzone animation frame (0..KZ_NUM_FRAMES-1)
5471  8051 00           KzFrameWait:     DB 0  ; счётчик кадров до switch на след. anim-frame
5472  8052 00           KzTargetFrame:   DB 0  ; target frame (current animation moves toward it)
5473  8053 00           KzFrameLastBurned: DB 0  ; последний frame, выпеченный в golden — для re-burn при изменении
5474  8054 00 00        KzCenterX:       DW 0  ; центр killzone (= TrackData[TRACK_NUM_POINTS-1])
5475  8056 00 00        KzCenterY:       DW 0
5476  8058 00           KzVisible:       DB 0  ; 1 = killzone готов к рендеру (после Init)
5477  8059 00           TmpColorMask:    DB 0  ; 6-бит маска цветов цепочки (BuildColorMask)
5478  805A 00           ShotCooldown:    DB 0  ; счётчик кадров между выстрелами (preview скрыт когда > 0)
5479  805B 00           KeySpacePrev: DB 0     ; флаг debounce Space
5480  805C 00           MouseXPrev: DB 0
5481  805D 00           MouseYPrev: DB 0
5482  805E E0 00        MouseAbsX:  DW MOUSE_INIT_X   ; курсор справа от лягушки → стартовый угол ~0
5483  8060 E0 00        SmoothMouseX: DW MOUSE_INIT_X ; low-pass smoothed X (init = центр жабы)
5484  8062 8C 00        SmoothMouseY: DW MOUSE_INIT_Y ; low-pass smoothed Y
5485  8064 8C 00        MouseAbsY:  DW MOUSE_INIT_Y
5486  8066 00           MouseMoved:       DB 0  ; флаг: 1 если мышь двигалась в этом кадре
