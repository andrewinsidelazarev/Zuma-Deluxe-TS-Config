2970  6FB3              ; ================================================================
2971  6FB3              ; ANIMATE CHAIN — VDC модель. Каждый GAP_STEP_FRAMES делает GAP-step:
2972  6FB3              ;   GAP_STOP двигается вправо (к tail в массиве): SWAP с Slots[k+1].
2973  6FB3              ;   GAP_CASCADE двигается влево (к head): SWAP с Slots[k-1].
2974  6FB3              ; Exit GAP с краёв массива → SlotsLen-=1 (для STOP) или shift_left+SlotsLen-=1+HSA-=1 (для CASCADE).
2975  6FB3              ; После GAP-step → match-scan для триггера новых match'ей (cascade chain).
2976  6FB3              ; ChainStalled=1 пока в Slots есть GAP-cells.
2977  6FB3              ; ================================================================
2978  6FB3              AnimateChain:
2979  6FB3                  ; --- Explosion-анимация: increment ExplodingFrame, финализация после EXPLOSION_FRAMES ---
2980  6FB3 3A 9E 85         LD A, (Chain0_SlotsLen)
2981  6FB6 B7               OR A
2982  6FB7 28 32            JR Z, .ac_after_explode
2983  6FB9 47               LD B, A
2984  6FBA 21 BC 83         LD HL, Chain0_ExplodingFrame
2985  6FBD              .ac_explode_loop:
2986  6FBD 7E               LD A, (HL)
2987  6FBE B7               OR A
2988  6FBF 28 27            JR Z, .ac_explode_next
2989  6FC1 3C               INC A
2990  6FC2 FE 0F            CP EXPLOSION_FRAMES + 1
2991  6FC4 38 21            JR C, .ac_explode_save
2992  6FC6                  ; Frame >= EXPLOSION_FRAMES → финализация: Slots[i]=ExplodingMarker[i], ExplodingFrame[i]=0.
2993  6FC6 AF               XOR A
2994  6FC7 77               LD (HL), A                                ; ExplodingFrame[i] = 0
2995  6FC8 E5               PUSH HL
2996  6FC9 C5               PUSH BC
2997  6FCA 3A 9E 85         LD A, (Chain0_SlotsLen)
2998  6FCD 90               SUB B                                     ; A = i (поскольку B уменьшается с len до 1)
2999  6FCE 26 00            LD H, 0
2999  6FD0 6F             LD L, A
3000  6FD1 11 AC 84         LD DE, Chain0_ExplodingMarker
3001  6FD4 19               ADD HL, DE
3002  6FD5 7E               LD A, (HL)                                ; A = saved GAP_STOP/CASCADE
3003  6FD6 4F               LD C, A
3004  6FD7 3A 9E 85         LD A, (Chain0_SlotsLen)
3005  6FDA 90               SUB B
3006  6FDB 26 00            LD H, 0
3006  6FDD 6F             LD L, A
3007  6FDE 11 EC 80         LD DE, Chain0_Slots
3008  6FE1 19               ADD HL, DE
3009  6FE2 71               LD (HL), C                                ; Slots[i] = marker
3010  6FE3 C1               POP BC
3011  6FE4 E1               POP HL
3012  6FE5 18 01            JR .ac_explode_next
3013  6FE7              .ac_explode_save:
3014  6FE7 77               LD (HL), A
3015  6FE8              .ac_explode_next:
3016  6FE8 23               INC HL
3017  6FE9 10 D2            DJNZ .ac_explode_loop
3018  6FEB              .ac_after_explode:
3019  6FEB
3020  6FEB                  ; Каждый кадр decay'им offsets к 0 на 1 px (= плавное движение GAP-step через offsets).
3021  6FEB 3A 9E 85         LD A, (Chain0_SlotsLen)
3022  6FEE B7               OR A
