1789  690C              ; LFSR16 — Galois 16-битный, polynomial $D008. Период 65535.
1790  690C              ; Вход: HL = текущий seed (≠0). Выход: HL = новый seed.
1791  690C              ; ================================================================
1792  690C              LFSR16:
1793  690C CB 3C            SRL H
1794  690E CB 1D            RR L
1795  6910 D0               RET NC
1796  6911 7C               LD A, H
1796  6912 EE D0          XOR $D0
1796  6914 67             LD H, A
1797  6915 7D               LD A, L
1797  6916 EE 08          XOR $08
1797  6918 6F             LD L, A
1798  6919 C9               RET
