4310  77F7 80               ADD A, B
4311  77F8 01 AF 1F         LD BC, DMADADX
4311  77FB ED 79          OUT (C), A
4312  77FD
4313  77FD 3E B9            LD A, DMA_BLT_8BPP_MODE
4313  77FF 01 AF 27       LD BC, DMACTR
4313  7802 ED 79          OUT (C), A
4314  7804              .bcs_blit_wait:
4315  7804 ED 78            IN A, (C)
4316  7806 E6 80            AND DMAWNR
4317  7808 20 FA            JR NZ, .bcs_blit_wait
4318  780A
4319  780A                  ; --- save new dst as prev ---
4320  780A 3A 00 40         LD A, (BcsDstLow)
4320  780D DD 77 00       LD (IX+0), A
4321  7810 3A 01 40         LD A, (BcsDstMid)
4321  7813 DD 77 01       LD (IX+1), A
4322  7816 3A 02 40         LD A, (BcsPageOver)
4323  7819 47               LD B, A
4324  781A 3A 14 40         LD A, (ShadowPageBase)
4325  781D 80               ADD A, B
