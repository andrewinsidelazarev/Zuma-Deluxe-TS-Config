4251  776A CA 7C 77         JP Z, .bcs_draw
4252  776D FE 01            CP BCS_DESTROY
4253  776F CA 75 77         JP Z, .bcs_destroy
4254  7772                  ; PRESERVE: prev не трогаем
4255  7772 C3 2B 78         JP .bcs_advance
4256  7775
4257  7775              .bcs_destroy:
4258  7775 FD 36 00 00      LD (IY+0), 0
