 998  641B              ; ================================================================
 999  641B              ; УГОЛ ЛЯГУШКИ К КУРСОРУ МЫШИ
1000  641B              ; Вход: MouseAbsX, MouseAbsY; лягушка зафиксирована в FrogX/FrogY
1001  641B              ; Выход: FrogAngle (0=вправо, 64=вниз, 128=влево, 192=вверх)
1002  641B              ; ================================================================
1003  641B              ComputeFrogAngle:
1004  641B                  ; dx = (SmoothMouseX + 8) - (FrogX + 32) = SmoothMouseX - FrogX - 24
1005  641B                  ; (центр курсора 16×16 относительно центра жабы 64×64). Используется
1006  641B                  ; SmoothMouseX/Y, не raw — иначе кадровое jitter перекидывает FrogAngle.
1007  641B 2A 60 80         LD HL, (SmoothMouseX)
1008  641E ED 5B 3A 80      LD DE, (FrogX)
1009  6422 A7               AND A
1010  6423 ED 52            SBC HL, DE
1011  6425 11 18 00         LD DE, 24
1012  6428 A7               AND A
1013  6429 ED 52            SBC HL, DE
1014  642B
1015  642B 06 00            LD B, 0             ; флаги: бит0=dx<0, бит1=dy<0, бит2=|dy|>|dx|
1016  642D CB 7C            BIT 7, H
1017  642F 28 09            JR Z, .dx_pos
1018  6431 CB C0            SET 0, B
1019  6433 7C               LD A, H
1019  6434 2F             CPL
1019  6435 67             LD H, A
1020  6436 7D               LD A, L
1020  6437 2F             CPL
1020  6438 6F             LD L, A
1021  6439 23               INC HL
1022  643A              .dx_pos:
1023  643A 4D               LD C, L             ; C = |dx| (≤200, в 8 бит)
1024  643B
1025  643B                  ; dy = (SmoothMouseY + 8) - (FrogY + 32) = SmoothMouseY - FrogY - 24
1026  643B 2A 62 80         LD HL, (SmoothMouseY)
1027  643E ED 5B 3C 80      LD DE, (FrogY)
1028  6442 A7               AND A
1029  6443 ED 52            SBC HL, DE
1030  6445 11 18 00         LD DE, 24
1031  6448 A7               AND A
1032  6449 ED 52            SBC HL, DE
1033  644B
1034  644B CB 7C            BIT 7, H
1035  644D 28 09            JR Z, .dy_pos
1036  644F CB C8            SET 1, B
1037  6451 7C               LD A, H
1037  6452 2F             CPL
1037  6453 67             LD H, A
1038  6454 7D               LD A, L
1038  6455 2F             CPL
