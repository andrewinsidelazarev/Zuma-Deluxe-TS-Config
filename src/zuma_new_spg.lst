3957  751F              ; ================================================================
3958  751F              ; ONE-TIME BLIT KZ TO GOLDEN — выпекает kz pixels в golden pages #30..#38
3959  751F              ; ОДИН раз в init. После этого chain DMA PASS1 restore (читает golden) выдаёт
3960  751F              ; track+kz, не только track. Шары в kz-зоне восстанавливаются корректно, без
3961  751F              ; «track-цветных дыр» в килл-зоне на местах prev ball positions.
3962  751F              ;
3963  751F              ; Реализация: подменяем ShadowPageBase на GOLDEN_PAGE_BASE и BcsGoldenOff=0
3964  751F              ; (= source page = ShadowPageBase + BcsGoldenOff = #30 = golden), вызываем
3965  751F              ; BlitKillzoneToShadow. KzRestoreHalf делает golden→golden = no-op, KzBlitHalf
3966  751F              ; пишет kz src page → golden. Возвращаем переменные обратно.
3967  751F              ; ================================================================
3968  751F              OneTimeBlitKzToGolden:
3969  751F 3A 14 40         LD A, (ShadowPageBase)
3970  7522 F5               PUSH AF
3971  7523 3A 06 40         LD A, (BcsGoldenOff)
3972  7526 F5               PUSH AF
3973  7527 3E 30            LD A, GOLDEN_PAGE_BASE
3974  7529 32 14 40         LD (ShadowPageBase), A
3975  752C AF               XOR A
3976  752D 32 06 40         LD (BcsGoldenOff), A
3977  7530 CD C0 79         CALL BlitKillzoneToShadow
3978  7533 F1               POP AF
3979  7534 32 06 40         LD (BcsGoldenOff), A
3980  7537 F1               POP AF
3981  7538 32 14 40         LD (ShadowPageBase), A
3982  753B C9               RET
3983  753C
3984  753C              ; ================================================================
3985  753C              ; UPDATE GAME OVER TEXT — записывает 7 TSU sprites 32×32 в DESC_CHAIN0[0..6]
3986  753C              ; (= reuse chain TSU descriptors, в state 2 chain пуст и hidden). Каждый sprite =
3987  753C              ; одна 32-px секция текста "GAME OVER", вместе 7×32=224 px wide centered (X=68).
3988  753C              ; TNUM = GAMEOVER_TNUM_BASE + N*4 (sprite N в carpet col N*4 page #0D rows 4..7).
3989  753C              ; SPAL=4 (yellow CRAM #40..#4F).
3990  753C              ; ================================================================
3991  753C              UpdateGameOverText:
3992  753C 21 00 0E         LD HL, GAMEOVER_TNUM_BASE
3993  753F 18 09            JR DrawTextOverlay
3994  7541
3995  7541              UpdateLevelIntroText:
